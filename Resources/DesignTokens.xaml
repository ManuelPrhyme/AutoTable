<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════
         THEME DICTIONARIES — Light & Dark
         Colors and brushes that change per theme live here.
         Styles in the main dictionary reference brushes via
         {ThemeResource} so they update on theme switch.
    ═══════════════════════════════════════════════════════════ -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ── LIGHT THEME ── -->
        <ResourceDictionary x:Key="Light">

            <!-- ═══ BASE COLORS ═══ -->
            <!-- Background -->
            <Color x:Key="BackgroundColor">#F5F5F5</Color>
            <Color x:Key="SurfaceWhiteColor">#FFFFFF</Color>
            <Color x:Key="SurfaceGrayColor">#F5F5F5</Color>
            <Color x:Key="SurfaceGray2Color">#EEEEEE</Color>

            <!-- Text -->
            <Color x:Key="TextPrimaryColor">#2D2D2D</Color>
            <Color x:Key="TextSecondaryColor">#666666</Color>
            <Color x:Key="TextMutedColor">#9E9E9E</Color>
            <Color x:Key="TextOnDarkColor">#FFFFFF</Color>
            <Color x:Key="TextOnDarkMutedColor">#CCCCCC</Color>

            <!-- Sidebar / Navigation -->
            <Color x:Key="SidebarColor">#1E1E1E</Color>
            <Color x:Key="SidebarHoverColor">#2A2A2A</Color>
            <Color x:Key="SidebarBorderColor">#2A2A2A</Color>

            <!-- Dividers / Lines -->
            <Color x:Key="DividerColor">#DDDDDD</Color>
            <Color x:Key="BorderLightColor">#DDDDDD</Color>
            <Color x:Key="BorderMediumColor">#CCCCCC</Color>

            <!-- Hover / Focus States -->
            <Color x:Key="HoverBlueColor">#E3F2FD</Color>
            <Color x:Key="HoverGrayColor">#EEEEEE</Color>

            <!-- Table -->
            <Color x:Key="TableRowAltColor">#FAFAFA</Color>
            <Color x:Key="TableSelectedRowColor">#E3F2FD</Color>

            <!-- Buttons -->
            <Color x:Key="DisabledButtonBackgroundColor">#E0E0E0</Color>
            <Color x:Key="DisabledButtonTextColor">#9E9E9E</Color>

            <!-- Overlay (semi-transparent black, 40% opacity) -->
            <Color x:Key="OverlayColor">#66000000</Color>

            <!-- Chart gridlines -->
            <Color x:Key="ChartGridlineColor">#DDDDDD</Color>

            <!-- Calendar -->
            <Color x:Key="CalendarCurrentDayColor">#2196F3</Color>
            <Color x:Key="CalendarInactiveDayTextColor">#666666</Color>

            <!-- ═══ ACCENT PALETTE (semantic mapping) ═══ -->
            <!-- Blue: Information, students, search highlights, analytics -->
            <Color x:Key="BlueColor">#2196F3</Color>
            <Color x:Key="BlueLightColor">#E3F2FD</Color>
            <Color x:Key="BlueHoverColor">#1976D2</Color>

            <!-- Green: Success, teachers, positive states, "Present" -->
            <Color x:Key="GreenColor">#4CAF50</Color>
            <Color x:Key="GreenLightColor">#E8F5E9</Color>
            <Color x:Key="GreenHoverColor">#388E3C</Color>

            <!-- Orange: Activity, classes, caution, "Late" -->
            <Color x:Key="OrangeColor">#FF9800</Color>
            <Color x:Key="OrangeLightColor">#FFF3E0</Color>
            <Color x:Key="OrangeHoverColor">#F57C00</Color>

            <!-- Red: Errors, warnings, "Absent" -->
            <Color x:Key="RedColor">#F44336</Color>
            <Color x:Key="RedLightColor">#FFEBEE</Color>
            <Color x:Key="RedHoverColor">#D32F2F</Color>

            <!-- Purple: Secondary highlights -->
            <Color x:Key="PurpleColor">#673AB7</Color>
            <Color x:Key="PurpleLightColor">#F3E5F5</Color>
            <Color x:Key="PurpleHoverColor">#512DA8</Color>

            <!-- Teal: Finance, fees -->
            <Color x:Key="TealColor">#009688</Color>
            <Color x:Key="TealLightColor">#E0F2F2</Color>
            <Color x:Key="TealHoverColor">#00796B</Color>

            <!-- ═══ BRUSHES (Light) ═══ -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceWhiteBrush" Color="{StaticResource SurfaceWhiteColor}" />
            <SolidColorBrush x:Key="SurfaceGrayBrush" Color="{StaticResource SurfaceGrayColor}" />
            <SolidColorBrush x:Key="SurfaceGray2Brush" Color="{StaticResource SurfaceGray2Color}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
            <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}" />
            <SolidColorBrush x:Key="TextOnDarkMutedBrush" Color="{StaticResource TextOnDarkMutedColor}" />

            <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource SidebarBorderColor}" />

            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
            <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
            <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMediumColor}" />

            <SolidColorBrush x:Key="HoverBlueBrush" Color="{StaticResource HoverBlueColor}" />
            <SolidColorBrush x:Key="HoverGrayBrush" Color="{StaticResource HoverGrayColor}" />

            <SolidColorBrush x:Key="TableRowAltBrush" Color="{StaticResource TableRowAltColor}" />
            <SolidColorBrush x:Key="TableSelectedRowBrush" Color="{StaticResource TableSelectedRowColor}" />

            <SolidColorBrush x:Key="DisabledButtonBackgroundBrush" Color="{StaticResource DisabledButtonBackgroundColor}" />
            <SolidColorBrush x:Key="DisabledButtonTextBrush" Color="{StaticResource DisabledButtonTextColor}" />

            <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />

            <SolidColorBrush x:Key="ChartGridlineBrush" Color="{StaticResource ChartGridlineColor}" />

            <SolidColorBrush x:Key="CalendarCurrentDayBrush" Color="{StaticResource CalendarCurrentDayColor}" />
            <SolidColorBrush x:Key="CalendarInactiveDayTextBrush" Color="{StaticResource CalendarInactiveDayTextColor}" />

            <!-- Accent brushes -->
            <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
            <SolidColorBrush x:Key="BlueLightBrush" Color="{StaticResource BlueLightColor}" />
            <SolidColorBrush x:Key="BlueHoverBrush" Color="{StaticResource BlueHoverColor}" />

            <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />
            <SolidColorBrush x:Key="GreenLightBrush" Color="{StaticResource GreenLightColor}" />
            <SolidColorBrush x:Key="GreenHoverBrush" Color="{StaticResource GreenHoverColor}" />

            <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}" />
            <SolidColorBrush x:Key="OrangeLightBrush" Color="{StaticResource OrangeLightColor}" />
            <SolidColorBrush x:Key="OrangeHoverBrush" Color="{StaticResource OrangeHoverColor}" />

            <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
            <SolidColorBrush x:Key="RedLightBrush" Color="{StaticResource RedLightColor}" />
            <SolidColorBrush x:Key="RedHoverBrush" Color="{StaticResource RedHoverColor}" />

            <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
            <SolidColorBrush x:Key="PurpleLightBrush" Color="{StaticResource PurpleLightColor}" />
            <SolidColorBrush x:Key="PurpleHoverBrush" Color="{StaticResource PurpleHoverColor}" />

            <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
            <SolidColorBrush x:Key="TealLightBrush" Color="{StaticResource TealLightColor}" />
            <SolidColorBrush x:Key="TealHoverBrush" Color="{StaticResource TealHoverColor}" />

            <!-- Semantic aliases (backward-compatible + semantic clarity) -->
            <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource BlueColor}" />
            <SolidColorBrush x:Key="PrimaryBlueHoverBrush" Color="{StaticResource BlueHoverColor}" />
            <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource PurpleColor}" />
            <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource GreenColor}" />
            <SolidColorBrush x:Key="SuccessGreenLightBrush" Color="{StaticResource GreenLightColor}" />
            <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource OrangeColor}" />
            <SolidColorBrush x:Key="WarningAmberLightBrush" Color="{StaticResource OrangeLightColor}" />
            <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource RedColor}" />
            <SolidColorBrush x:Key="DangerRedLightBrush" Color="{StaticResource RedLightColor}" />
            <SolidColorBrush x:Key="InfoBlueBrush" Color="{StaticResource BlueColor}" />
            <SolidColorBrush x:Key="InfoBlueLightBrush" Color="{StaticResource BlueLightColor}" />
            <SolidColorBrush x:Key="WarningOrangeBrush" Color="{StaticResource OrangeColor}" />
            <SolidColorBrush x:Key="NavySidebarBrush" Color="{StaticResource SidebarColor}" />
            <SolidColorBrush x:Key="NavyDarkBrush" Color="{StaticResource SidebarColor}" />
            <SolidColorBrush x:Key="NavyActiveBrush" Color="{StaticResource SidebarHoverColor}" />
        </ResourceDictionary>

        <!-- ── DARK THEME ── -->
        <ResourceDictionary x:Key="Dark">

            <!-- ═══ BASE COLORS ═══ -->
            <Color x:Key="BackgroundColor">#1E1E1E</Color>
            <Color x:Key="SurfaceWhiteColor">#2D2D2D</Color>
            <Color x:Key="SurfaceGrayColor">#1E1E1E</Color>
            <Color x:Key="SurfaceGray2Color">#2D2D2D</Color>

            <!-- Text -->
            <Color x:Key="TextPrimaryColor">#E0E0E0</Color>
            <Color x:Key="TextSecondaryColor">#A0A0A0</Color>
            <Color x:Key="TextMutedColor">#757575</Color>
            <Color x:Key="TextOnDarkColor">#E0E0E0</Color>
            <Color x:Key="TextOnDarkMutedColor">#A0A0A0</Color>

            <!-- Sidebar / Navigation -->
            <Color x:Key="SidebarColor">#121212</Color>
            <Color x:Key="SidebarHoverColor">#1E1E1E</Color>
            <Color x:Key="SidebarBorderColor">#1E1E1E</Color>

            <!-- Dividers / Lines -->
            <Color x:Key="DividerColor">#333333</Color>
            <Color x:Key="BorderLightColor">#333333</Color>
            <Color x:Key="BorderMediumColor">#444444</Color>

            <!-- Hover / Focus States -->
            <Color x:Key="HoverBlueColor">#1E3A5F</Color>
            <Color x:Key="HoverGrayColor">#2D2D2D</Color>

            <!-- Table -->
            <Color x:Key="TableRowAltColor">#252525</Color>
            <Color x:Key="TableSelectedRowColor">#1E3A5F</Color>

            <!-- Buttons -->
            <Color x:Key="DisabledButtonBackgroundColor">#3A3A3A</Color>
            <Color x:Key="DisabledButtonTextColor">#757575</Color>

            <!-- Overlay (semi-transparent black, 40% opacity) -->
            <Color x:Key="OverlayColor">#66000000</Color>

            <!-- Chart gridlines -->
            <Color x:Key="ChartGridlineColor">#333333</Color>

            <!-- Calendar -->
            <Color x:Key="CalendarCurrentDayColor">#2196F3</Color>
            <Color x:Key="CalendarInactiveDayTextColor">#A0A0A0</Color>

            <!-- ═══ ACCENT PALETTE (same vibrant accents for both themes) ═══ -->
            <Color x:Key="BlueColor">#2196F3</Color>
            <Color x:Key="BlueLightColor">#1E3A5F</Color>
            <Color x:Key="BlueHoverColor">#1976D2</Color>

            <Color x:Key="GreenColor">#4CAF50</Color>
            <Color x:Key="GreenLightColor">#1B5E20</Color>
            <Color x:Key="GreenHoverColor">#388E3C</Color>

            <Color x:Key="OrangeColor">#FF9800</Color>
            <Color x:Key="OrangeLightColor">#E65100</Color>
            <Color x:Key="OrangeHoverColor">#F57C00</Color>

            <Color x:Key="RedColor">#F44336</Color>
            <Color x:Key="RedLightColor">#B71C1C</Color>
            <Color x:Key="RedHoverColor">#D32F2F</Color>

            <Color x:Key="PurpleColor">#673AB7</Color>
            <Color x:Key="PurpleLightColor">#4A148C</Color>
            <Color x:Key="PurpleHoverColor">#512DA8</Color>

            <Color x:Key="TealColor">#009688</Color>
            <Color x:Key="TealLightColor">#004D40</Color>
            <Color x:Key="TealHoverColor">#00796B</Color>

            <!-- ═══ BRUSHES (Dark) ═══ -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceWhiteBrush" Color="{StaticResource SurfaceWhiteColor}" />
            <SolidColorBrush x:Key="SurfaceGrayBrush" Color="{StaticResource SurfaceGrayColor}" />
            <SolidColorBrush x:Key="SurfaceGray2Brush" Color="{StaticResource SurfaceGray2Color}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
            <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}" />
            <SolidColorBrush x:Key="TextOnDarkMutedBrush" Color="{StaticResource TextOnDarkMutedColor}" />

            <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource SidebarBorderColor}" />

            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
            <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
            <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMediumColor}" />

            <SolidColorBrush x:Key="HoverBlueBrush" Color="{StaticResource HoverBlueColor}" />
            <SolidColorBrush x:Key="HoverGrayBrush" Color="{StaticResource HoverGrayColor}" />

            <SolidColorBrush x:Key="TableRowAltBrush" Color="{StaticResource TableRowAltColor}" />
            <SolidColorBrush x:Key="TableSelectedRowBrush" Color="{StaticResource TableSelectedRowColor}" />

            <SolidColorBrush x:Key="DisabledButtonBackgroundBrush" Color="{StaticResource DisabledButtonBackgroundColor}" />
            <SolidColorBrush x:Key="DisabledButtonTextBrush" Color="{StaticResource DisabledButtonTextColor}" />

            <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />

            <SolidColorBrush x:Key="ChartGridlineBrush" Color="{StaticResource ChartGridlineColor}" />

            <SolidColorBrush x:Key="CalendarCurrentDayBrush" Color="{StaticResource CalendarCurrentDayColor}" />
            <SolidColorBrush x:Key="CalendarInactiveDayTextBrush" Color="{StaticResource CalendarInactiveDayTextColor}" />

            <!-- Accent brushes -->
            <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
            <SolidColorBrush x:Key="BlueLightBrush" Color="{StaticResource BlueLightColor}" />
            <SolidColorBrush x:Key="BlueHoverBrush" Color="{StaticResource BlueHoverColor}" />

            <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />
            <SolidColorBrush x:Key="GreenLightBrush" Color="{StaticResource GreenLightColor}" />
            <SolidColorBrush x:Key="GreenHoverBrush" Color="{StaticResource GreenHoverColor}" />

            <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}" />
            <SolidColorBrush x:Key="OrangeLightBrush" Color="{StaticResource OrangeLightColor}" />
            <SolidColorBrush x:Key="OrangeHoverBrush" Color="{StaticResource OrangeHoverColor}" />

            <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
            <SolidColorBrush x:Key="RedLightBrush" Color="{StaticResource RedLightColor}" />
            <SolidColorBrush x:Key="RedHoverBrush" Color="{StaticResource RedHoverColor}" />

            <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
            <SolidColorBrush x:Key="PurpleLightBrush" Color="{StaticResource PurpleLightColor}" />
            <SolidColorBrush x:Key="PurpleHoverBrush" Color="{StaticResource PurpleHoverColor}" />

            <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
            <SolidColorBrush x:Key="TealLightBrush" Color="{StaticResource TealLightColor}" />
            <SolidColorBrush x:Key="TealHoverBrush" Color="{StaticResource TealHoverColor}" />

            <!-- Semantic aliases -->
            <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource BlueColor}" />
            <SolidColorBrush x:Key="PrimaryBlueHoverBrush" Color="{StaticResource BlueHoverColor}" />
            <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource PurpleColor}" />
            <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource GreenColor}" />
            <SolidColorBrush x:Key="SuccessGreenLightBrush" Color="{StaticResource GreenLightColor}" />
            <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource OrangeColor}" />
            <SolidColorBrush x:Key="WarningAmberLightBrush" Color="{StaticResource OrangeLightColor}" />
            <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource RedColor}" />
            <SolidColorBrush x:Key="DangerRedLightBrush" Color="{StaticResource RedLightColor}" />
            <SolidColorBrush x:Key="InfoBlueBrush" Color="{StaticResource BlueColor}" />
            <SolidColorBrush x:Key="InfoBlueLightBrush" Color="{StaticResource BlueLightColor}" />
            <SolidColorBrush x:Key="WarningOrangeBrush" Color="{StaticResource OrangeColor}" />
            <SolidColorBrush x:Key="NavySidebarBrush" Color="{StaticResource SidebarColor}" />
            <SolidColorBrush x:Key="NavyDarkBrush" Color="{StaticResource SidebarColor}" />
            <SolidColorBrush x:Key="NavyActiveBrush" Color="{StaticResource SidebarHoverColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ═══════════════════════════════════════════════════════════
         SPACING — 8px grid
    ═══════════════════════════════════════════════════════════ -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>

    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="RowPadding">16,10</Thickness>

    <!-- ═══════════════════════════════════════════════════════════
         SHAPE
    ═══════════════════════════════════════════════════════════ -->
    <x:Double x:Key="CardCornerRadius">10</x:Double>
    <x:Double x:Key="BadgeCornerRadius">6</x:Double>
    <x:Double x:Key="ButtonCornerRadius">8</x:Double>
    <CornerRadius x:Key="CardCornerRadiusValue">10</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadiusValue">6</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadiusValue">8</CornerRadius>

    <!-- ═══════════════════════════════════════════════════════════
         TYPOGRAPHY STYLES
    ═══════════════════════════════════════════════════════════ -->
    <!-- Page title: 20px Semibold -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- Section header: 16px Semibold -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- Card label: 13px Regular muted -->
    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- Body text: 14px Regular -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- KPI number: 28px Bold -->
    <Style x:Key="KpiValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- Table header: 13px Semibold with accent underline -->
    <Style x:Key="TableHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- Table cell: 14px Regular -->
    <Style x:Key="TableCellStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- Numeric data: 14px Bold -->
    <Style x:Key="NumericCellStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- Sidebar item text -->
    <Style x:Key="SidebarItemTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnDarkBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CARD STYLES
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadiusValue}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- Subtle shadow-like brush used for elevated surfaces -->
    <Color x:Key="CardShadowColor">#0A000000</Color>
    <SolidColorBrush x:Key="CardShadowBrush" Color="{StaticResource CardShadowColor}" />

    <!-- KPI card with left accent bar -->
    <Style x:Key="KpiCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadiusValue}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="MinHeight" Value="96" />
    </Style>

    <!-- Table container card -->
    <Style x:Key="TableCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadiusValue}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Filter bar card -->
    <Style x:Key="FilterBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadiusValue}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         TABLE HEADER ROW
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="TableHeaderRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceGray2Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         TABLE ROW STYLES — alternating shading + selected highlight
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="TableRowStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="TableRowAltStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="{ThemeResource TableRowAltBrush}" />
    </Style>

    <Style x:Key="TableRowSelectedStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="{ThemeResource TableSelectedRowBrush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         STATUS BADGE STYLES — filled circles / badges
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="BadgeSuccessStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GreenLightBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource BadgeCornerRadiusValue}" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="BadgeWarningStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource OrangeLightBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource BadgeCornerRadiusValue}" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="BadgeDangerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RedLightBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource BadgeCornerRadiusValue}" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="BadgeInfoStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BlueLightBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource BadgeCornerRadiusValue}" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="BadgeNeutralStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceGray2Brush}" />
        <Setter Property="CornerRadius" Value="{StaticResource BadgeCornerRadiusValue}" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- Status indicator — filled circle -->
    <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         BUTTON STYLES — accent bg, white text, hover darker, disabled gray
         NOTE: WinUI 3 does not support Style.Triggers. Visual states
         are handled via the Button's default template / VSM.
         These styles set the base appearance; hover/disabled states
         are managed by the control's built-in VisualStateManager.
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource BlueBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadiusValue}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SurfaceWhiteBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderMediumBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadiusValue}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource BlueBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadiusValue}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource RedBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadiusValue}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadiusValue}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         PROGRESS BAR STYLE
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="AccentProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Foreground" Value="{ThemeResource BlueBrush}" />
        <Setter Property="Background" Value="{ThemeResource SurfaceGray2Brush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         DIVIDER
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="DividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource BorderLightBrush}" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION HEADER WITH SUBTITLE
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="CardHeaderBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceGray2Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderMediumBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         DROPDOWN / COMBOBOX STYLES
         White background, dark text, accent highlight on hover.
         Selected item has bold accent border (#2196F3).
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{ThemeResource SurfaceWhiteBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadiusValue}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         SEARCH BAR STYLE
         White background, subtle gray border (#DDDDDD),
         blue accent (#2196F3) for active focus.
         Placeholder text in medium gray (#666666).
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="SearchBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource SurfaceWhiteBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadiusValue}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PlaceholderForeground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CALENDAR STYLES
         Current day highlighted in blue (#2196F3).
         Selected day = filled accent background with white text.
         Non-active days = medium gray text.
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="CalendarStyle" TargetType="CalendarView">
        <Setter Property="Background" Value="{ThemeResource SurfaceWhiteBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadiusValue}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CHART STYLES
         Neutral background, gridlines in light gray (#DDDDDD).
         Series use accent colors consistently.
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="ChartBackgroundStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceGrayBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Chart series brushes — semantic mapping -->
    <!-- Blue = students, Green = teachers, Orange = classes, Red = warnings -->
    <SolidColorBrush x:Key="ChartSeriesStudentsBrush" Color="{ThemeResource BlueColor}" />
    <SolidColorBrush x:Key="ChartSeriesTeachersBrush" Color="{ThemeResource GreenColor}" />
    <SolidColorBrush x:Key="ChartSeriesClassesBrush" Color="{ThemeResource OrangeColor}" />
    <SolidColorBrush x:Key="ChartSeriesWarningsBrush" Color="{ThemeResource RedColor}" />

    <!-- ═══════════════════════════════════════════════════════════
         DIALOG / POPUP STYLES
         White background, dark text, accent-colored action buttons.
         Overlay background = semi-transparent black (40% opacity).
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="ModalDialogStyle" TargetType="ContentDialog">
        <Setter Property="Background" Value="{ThemeResource SurfaceWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadiusValue}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Dialog overlay (semi-transparent black, 40% opacity) -->
    <SolidColorBrush x:Key="DialogOverlayBrush" Color="{StaticResource OverlayColor}" />

    <!-- Dialog action button — accent background with white text -->
    <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}" />

    <!-- Dialog close button — top-right, ghost style -->
    <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadiusValue}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         MODAL CONTAINER STYLE
         90% of screen, centrally aligned
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="ModalContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadiusValue}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="MaxWidth" Value="1440" />
        <Setter Property="MaxHeight" Value="800" />
    </Style>

</ResourceDictionary>
