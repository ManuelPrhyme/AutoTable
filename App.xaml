<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AutoTable.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:AutoTable.Converters"
    xmlns:local="using:AutoTable">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:DateFormatConverter    x:Key="DateFormatConverter" />
            <converters:CurrencyConverter      x:Key="CurrencyConverter" />
            <converters:PercentConverter       x:Key="PercentConverter" />
            <converters:DecimalConverter       x:Key="DecimalConverter" />
            <converters:GradeColorConverter    x:Key="GradeColorConverter" />
            <converters:StatusColorConverter   x:Key="StatusColorConverter" />
            <converters:RoundPercentConverter  x:Key="RoundPercentConverter" />
            <converters:BalanceTextConverter    x:Key="BalanceTextConverter" />
            <converters:BalanceColorConverter   x:Key="BalanceColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

