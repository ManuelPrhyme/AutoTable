<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.ClassesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource SurfaceGrayBrush}">
    <Grid Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Classes list -->
        <StackPanel Grid.Column="0" Spacing="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Classes" Style="{ThemeResource SectionTitleStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="New" Click="CreateClass_Click" Style="{ThemeResource PrimaryButtonStyle}" />
            </Grid>

            <ListView x:Name="ClassesList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="ClassesList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="8">
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Right: Selected class details -->
        <StackPanel Grid.Column="1" Spacing="12" Padding="12,0,0,0">
            <TextBlock x:Name="SelectedClassTitle" Text="Select a class" Style="{ThemeResource SectionTitleStyle}" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SubjectPicker" PlaceholderText="Choose subject to assign" Width="320"/>
                <Button Grid.Column="1" Content="Assign" Click="AssignSubject_Click" Style="{ThemeResource SecondaryButtonStyle}" />
            </Grid>

            <TextBlock Text="Assigned Subjects" Style="{ThemeResource SubtleHeaderStyle}" />
            <ListView x:Name="AssignedSubjectsList" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="8">
                            <TextBlock Text="{Binding Name}" Width="300" />
                            <Button Content="Remove" Click="RemoveSubject_Click" Style="{ThemeResource DangerButtonStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="NewSubjectName" PlaceholderText="New subject name" Width="240" />
                <Button Content="Create Subject" Click="CreateSubject_Click" Style="{ThemeResource PrimaryButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
