<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.StudentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:AutoTable.Converters"
    Background="{ThemeResource SurfaceGrayBrush}">

    <Page.Resources>
        <converters:StatusColorConverter x:Key="StatusColor" />
        <converters:StatusLabelConverter x:Key="StatusLabelConv" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <!-- ── FILTER BAR ── -->
            <Border Style="{ThemeResource FilterBarStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ClassFilterBox" Header="Class" MinWidth="120"
                              DisplayMemberPath="Name" SelectionChanged="ClassFilter_Changed"
                              HorizontalAlignment="Left" />
                    <ComboBox x:Name="StreamFilterBox" Header="Stream" MinWidth="120"
                              Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="StreamFilter_Changed"
                              HorizontalAlignment="Left" />
                    <ComboBox x:Name="StatusFilterBox" Header="Status" MinWidth="100"
                              Grid.Column="2" SelectionChanged="StatusFilter_Changed"
                              HorizontalAlignment="Left" />
                    <ComboBox x:Name="TermYearFilterBox" Header="Termination Year" MinWidth="110"
                              Grid.Column="3" SelectionChanged="TermYearFilter_Changed"
                              HorizontalAlignment="Left" Visibility="Collapsed" />
                    <!-- spacer column 4 (24px) separates filters from search -->
                    <TextBox x:Name="SearchBox" Header="Search" PlaceholderText="Name or LIN"
                             TextChanged="SearchBox_TextChanged"
                             Grid.Column="5" MinWidth="220"
                             VerticalAlignment="Bottom" />
                    <Button Grid.Column="6" VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Content="Add Student" Click="AddStudent_Click"
                            Style="{ThemeResource PrimaryButtonStyle}" />
                </Grid>
            </Border>

            <!-- ── STUDENTS TABLE ── -->
            <Border Style="{ThemeResource TableCardStyle}">
                <StackPanel>
                    <!-- Table Header -->
                    <Border Style="{ThemeResource CardHeaderBorderStyle}">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Students" />
                    </Border>

                    <!-- Column Headers -->
                    <Border Style="{ThemeResource TableHeaderRowStyle}">
                        <Grid ColumnSpacing="4" Padding="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2.8*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="2.1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}"
                                       Text="LIN" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}"
                                       Text="FULL NAME" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}"
                                       Text="CLASS" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}"
                                       Text="STREAM" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}"
                                       Text="STATUS" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="5" Style="{ThemeResource TableHeaderStyle}"
                                       Text="ACTIONS" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>

                    <!-- Data Rows -->
                    <ListView
                        x:Name="StudentsList"
                        ItemsSource="{x:Bind FilteredStudents}"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        MaxHeight="480"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Student" xmlns:models="using:AutoTable.Models">
                                <Grid ColumnSpacing="4" Padding="16,8" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="2.8*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="2.1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource TableCellStyle}"
                                               Text="{x:Bind LIN}" FontWeight="SemiBold"
                                               HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Style="{ThemeResource TableCellStyle}"
                                               Text="{x:Bind FullName}"
                                               HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Style="{ThemeResource TableCellStyle}"
                                               Text="{x:Bind ClassName}"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="3" Style="{ThemeResource TableCellStyle}"
                                               Text="{x:Bind StreamName}"
                                               HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                                    <!-- Status: colored dot + label + cause (cause shown below for inactive) -->
                                    <StackPanel Grid.Column="4" Spacing="1"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                     Fill="{x:Bind StatusDotSource, Converter={StaticResource StatusColor}}" />
                                            <TextBlock Text="{x:Bind StatusDotSource, Converter={StaticResource StatusLabelConv}}"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind InactiveCauseText}" FontSize="10"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" Margin="16,0,0,0" />
                                    </StackPanel>
                                    <!-- Actions: all buttons in one cell -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button Content="Shift" FontSize="11" Padding="8,3"
                                                Style="{ThemeResource SecondaryButtonStyle}"
                                                Click="ShiftEnrollment_Click" Tag="{x:Bind Id}" />
                                        <Button Content="View" FontSize="11" Padding="8,3"
                                                Style="{ThemeResource SecondaryButtonStyle}"
                                                Click="ViewStudent_Click" Tag="{x:Bind Id}" />
                                        <Button Content="Edit" FontSize="11" Padding="8,3"
                                                Style="{ThemeResource SecondaryButtonStyle}"
                                                Click="EditStudent_Click" Tag="{x:Bind Id}" />
                                        <Button Content="Terminate" FontSize="11" Padding="8,3"
                                                Style="{ThemeResource DangerButtonStyle}"
                                                Click="TerminateStudent_Click" Tag="{x:Bind Id}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Status message -->
            <TextBlock Style="{ThemeResource MutedTextStyle}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</Page>
