<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.AuditLogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <!-- Page Title + Refresh -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{ThemeResource SectionTitleStyle}" Text="Audit Log" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Refresh" Style="{ThemeResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" />
            </Grid>

            <!-- Filter Bar -->
            <Border Style="{ThemeResource FilterBarStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Header="Category" PlaceholderText="All Categories"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <ComboBox Grid.Column="1" Header="Operation" PlaceholderText="All Operations"
                                  ItemsSource="{Binding Operations}"
                                  SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <ComboBox Grid.Column="2" Header="User" PlaceholderText="All Users"
                                  ItemsSource="{Binding Users}"
                                  SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <ComboBox Grid.Column="3" Header="Status"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatusOption, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <CalendarDatePicker x:Name="FromPicker" Grid.Column="4" Header="From" PlaceholderText="Select date"
                                    HorizontalAlignment="Stretch"
                                    DateChanged="FromPicker_DateChanged" />
                        <CalendarDatePicker x:Name="ToPicker" Grid.Column="5" Header="To" PlaceholderText="Select date"
                                    HorizontalAlignment="Stretch"
                                    DateChanged="ToPicker_DateChanged" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchBox_TextChanged" />
                        <Button Grid.Column="1" Content="Apply Filter" Style="{ThemeResource SecondaryButtonStyle}" Click="ApplyFilter_Click" VerticalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>
            <!-- Audit Log Table (Table.md standard: Card -> title band -> column header band -> rows) -->
            <Border Style="{ThemeResource TableCardStyle}">
                <StackPanel>

                    <!-- Card Title -->
                    <Border Style="{ThemeResource CardHeaderBorderStyle}">
                        <TextBlock Text="Audit Log Entries" Style="{ThemeResource TableHeaderStyle}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="16,10" />
                    </Border>

                    <!-- Column Header Band -->
                    <Border Style="{ThemeResource TableHeaderRowStyle}">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}" Text="TIME" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}" Text="USER" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}" Text="ROLE" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}" Text="CATEGORY" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}" Text="OPERATION" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="5" Style="{ThemeResource TableHeaderStyle}" Text="ENTITY TYPE" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="6" Style="{ThemeResource TableHeaderStyle}" Text="ENTITY NAME" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="7" Style="{ThemeResource TableHeaderStyle}" Text="STATUS" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                    <!-- Data Rows -->
                    <ListView ItemsSource="{Binding AuditRows}" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="4" Padding="16,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource TableCellStyle}" Text="{Binding TimestampDisplay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Style="{ThemeResource TableCellStyle}" Text="{Binding UserName}" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Style="{ThemeResource TableCellStyle}" Text="{Binding UserRole}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Style="{ThemeResource TableCellStyle}" Text="{Binding Category}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Style="{ThemeResource TableCellStyle}" Text="{Binding Operation}" VerticalAlignment="Center" MaxWidth="130" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" Style="{ThemeResource TableCellStyle}" Text="{Binding EntityType}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Style="{ThemeResource TableCellStyle}" Text="{Binding EntityName}" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="7" Style="{ThemeResource TableCellStyle}" Text="{Binding SuccessText}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}" Style="{ThemeResource MutedTextStyle}" TextWrapping="Wrap" Margin="4,0" />

        </StackPanel>
    </ScrollViewer>
</Page>
