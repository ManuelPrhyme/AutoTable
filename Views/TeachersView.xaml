<?xml version="1.0" encoding="utf-8"?>
<Page NavigationCacheMode="Enabled"
    x:Class="AutoTable.Views.TeachersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AutoTable.Models"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Style="{ThemeResource PageTitleStyle}" Text="Teachers" />
            <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Register and manage teachers, their subjects, classes, next of kin and qualification status." />
            <Border Style="{ThemeResource TableCardStyle}">
                <StackPanel>
                    <Border Style="{ThemeResource CardHeaderBorderStyle}">
                        <Grid>
                            <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Registered Teachers" VerticalAlignment="Center" />
                            <Button x:Name="AddTeacherBtn" Content="+ Add Teacher" HorizontalAlignment="Right"
                                    Style="{ThemeResource PrimaryButtonStyle}"
                                    Click="AddTeacher_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{ThemeResource TableHeaderRowStyle}">
                        <Grid ColumnSpacing="16" Padding="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}" Text="NAME" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}" Text="CONTACT" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}" Text="SUBJECTS" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}" Text="CLASSES" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}" Text="NEXT OF KIN" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="5" Style="{ThemeResource TableHeaderStyle}" Text="ACTIONS" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                    <ListView ItemsSource="{Binding Teachers}" SelectionMode="None"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Teacher">
                                <Grid Padding="16,8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FullName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextMutedBrush}"
                                                   Text="{x:Bind QualificationLabel}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Text="{x:Bind Email}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock FontSize="12" Text="{x:Bind Phone}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                               Text="{x:Bind SubjectsTaught}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="3" FontSize="12" VerticalAlignment="Center"
                                               Text="{x:Bind ClassesTaught}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Text="{x:Bind NextOfKinDisplay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind NextOfKinPhone}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Content="Edit" Style="{ThemeResource SecondaryButtonStyle}"
                                                Padding="8,3" FontSize="12"
                                                Click="EditTeacher_Click" Tag="{x:Bind Id}" />
                                        <Button Content="Delete" Style="{ThemeResource DangerGhostButtonStyle}"
                                                Padding="8,3" FontSize="12"
                                                Click="DeleteTeacher_Click" Tag="{x:Bind Id}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Style="{ThemeResource MutedTextStyle}" Text="{Binding StatusMessage}" Margin="12,8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>