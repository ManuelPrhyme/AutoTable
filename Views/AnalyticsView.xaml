<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.AnalyticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <!-- FILTER BAR -->
            <Border Style="{StaticResource FilterBarStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Header="Term" MinWidth="140"
                              ItemsSource="{Binding Terms}"
                              SelectedItem="{Binding SelectedTerm, Mode=TwoWay}" />
                    <ComboBox Grid.Column="1" Header="Subject" MinWidth="160"
                              ItemsSource="{Binding Subjects}"
                              SelectedItem="{Binding SelectedSubject, Mode=TwoWay}" />
                    <Button Grid.Column="3" VerticalAlignment="Bottom"
                            Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <!-- KPI STRIP -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="School Average" />
                        <TextBlock Style="{StaticResource KpiValueStyle}"
                                   Foreground="{StaticResource PrimaryBlueBrush}"
                                   Text="{Binding SchoolAverage, Converter={StaticResource PercentConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Best Class" />
                        <TextBlock Style="{StaticResource KpiValueStyle}"
                                   Foreground="{StaticResource SuccessGreenBrush}"
                                   Text="{Binding BestClass}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Needs Attention" />
                        <TextBlock Style="{StaticResource KpiValueStyle}"
                                   Foreground="{StaticResource DangerRedBrush}"
                                   Text="{Binding NeedsAttentionClass}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Term Trend" />
                        <TextBlock Style="{StaticResource KpiValueStyle}"
                                   Foreground="{StaticResource SuccessGreenBrush}"
                                   Text="{Binding TrendLabel}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- CHARTS ROW -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Class Performance Bar Chart -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Class Performance Comparison" />
                        <Border Height="200" Background="{StaticResource SurfaceGrayBrush}" CornerRadius="8">
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        Orientation="Horizontal" Spacing="10" Padding="16,16">
                                <StackPanel Spacing="4">
                                    <Border Width="32" Height="72" Background="{StaticResource PrimaryBlueBrush}"
                                            CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.85" />
                                    <TextBlock Text="P1" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <Border Width="32" Height="88" Background="{StaticResource PrimaryBlueBrush}"
                                            CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.85" />
                                    <TextBlock Text="P2" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <Border Width="32" Height="64" Background="{StaticResource WarningAmberBrush}"
                                            CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.85" />
                                    <TextBlock Text="P3" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <Border Width="32" Height="100" Background="{StaticResource SuccessGreenBrush}"
                                            CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.85" />
                                    <TextBlock Text="P4" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <Border Width="32" Height="82" Background="{StaticResource PrimaryBlueBrush}"
                                            CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.9" />
                                    <TextBlock Text="P5" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <Border Width="32" Height="56" Background="{StaticResource DangerRedBrush}"
                                            CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.8" />
                                    <TextBlock Text="P6" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <Border Width="32" Height="94" Background="{StaticResource PrimaryBlueBrush}"
                                            CornerRadius="4" VerticalAlignment="Bottom" />
                                    <TextBlock Text="P7" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" Background="{StaticResource SuccessGreenBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Above 70%" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" Background="{StaticResource WarningAmberBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="50–70%" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" Background="{StaticResource DangerRedBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Below 50%" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Term Trend Line Chart -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Term-over-Term Trend" />
                        <Border Height="200" Background="{StaticResource SurfaceGrayBrush}" CornerRadius="8">
                            <Canvas>
                                <Polyline Canvas.Left="16" Canvas.Top="16"
                                          Stroke="{StaticResource PrimaryBlueBrush}" StrokeThickness="3"
                                          StrokeLineJoin="Round"
                                          Points="0,140 60,110 120,120 180,80 240,90 300,50 360,60" />
                                <Polyline Canvas.Left="16" Canvas.Top="16"
                                          Stroke="{StaticResource AccentPurpleBrush}" StrokeThickness="2"
                                          StrokeDashArray="4,3"
                                          Points="0,150 60,130 120,140 180,100 240,110 300,70 360,80" />
                            </Canvas>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="20" Height="3" Background="{StaticResource PrimaryBlueBrush}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="School Average" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="20" Height="3" Background="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="National Benchmark" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CLASS BREAKDOWN TABLE -->
            <Border Style="{StaticResource TableCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource CardHeaderBorderStyle}">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Class Breakdown" />
                    </Border>
                    <Border Style="{StaticResource TableHeaderRowStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderStyle}" Text="CLASS" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderStyle}" Text="STUDENTS" />
                            <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderStyle}" Text="AVERAGE" />
                            <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderStyle}" Text="AT RISK" />
                            <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderStyle}" Text="EXCELLENT" />
                            <TextBlock Grid.Column="5" Style="{StaticResource TableHeaderStyle}" Text="TREND" />
                        </Grid>
                    </Border>
                    <ListView ItemsSource="{Binding ClassBreakdown}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="16,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource TableCellStyle}"
                                               Text="{Binding ClassName}" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource NumericCellStyle}"
                                               Text="{Binding StudentCount}" />
                                    <TextBlock Grid.Column="2" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBlueBrush}"
                                               VerticalAlignment="Center"
                                               Text="{Binding Average, Converter={StaticResource PercentConverter}}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource NumericCellStyle}"
                                               Foreground="{StaticResource DangerRedBrush}"
                                               Text="{Binding AtRisk}" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource NumericCellStyle}"
                                               Foreground="{StaticResource SuccessGreenBrush}"
                                               Text="{Binding Excellent}" />
                                    <TextBlock Grid.Column="5" Style="{StaticResource TableCellStyle}"
                                               Text="{Binding Trend}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
