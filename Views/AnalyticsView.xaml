<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.AnalyticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <!-- FILTER BAR -->
            <Border Style="{ThemeResource FilterBarStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Header="Term" MinWidth="140"
                              ItemsSource="{Binding Terms}"
                              SelectedItem="{Binding SelectedTerm, Mode=TwoWay}" />
                    <ComboBox Grid.Column="1" Header="Subject" MinWidth="160"
                              ItemsSource="{Binding Subjects}"
                              SelectedItem="{Binding SelectedSubject, Mode=TwoWay}" />
                    <Button Grid.Column="3" VerticalAlignment="Bottom"
                            Content="Refresh" Style="{ThemeResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <!-- KPI STRIP -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="School Average" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource PrimaryBlueBrush}"
                                   Text="{Binding SchoolAverage, Converter={StaticResource PercentConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Best Class" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource SuccessGreenBrush}"
                                   Text="{Binding BestClass}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Needs Attention" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource DangerRedBrush}"
                                   Text="{Binding NeedsAttentionClass}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Term Trend" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource SuccessGreenBrush}"
                                   Text="{Binding TrendLabel}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- CHARTS ROW -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Class Performance Bar Chart (built from real data in code-behind) -->
                <Border Grid.Column="0" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Class Performance Comparison" />
                        <Border Height="220" Background="{ThemeResource SurfaceGrayBrush}" CornerRadius="8">
                            <StackPanel x:Name="BarChartPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        Orientation="Horizontal" Spacing="10" Padding="16,16" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" Background="{ThemeResource SuccessGreenBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Above 70%" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" Background="{ThemeResource WarningAmberBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Style="{ThemeResource MutedTextStyle}" Text="50-70%" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" Background="{ThemeResource DangerRedBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Below 50%" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Term Trend Line Chart (built from real data in code-behind) -->
                <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Term-over-Term Trend" />
                        <Border Height="220" Background="{ThemeResource SurfaceGrayBrush}" CornerRadius="8">
                            <Canvas x:Name="TrendChartCanvas" Margin="16,16" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="20" Height="3" Background="{ThemeResource PrimaryBlueBrush}" VerticalAlignment="Center" />
                                <TextBlock Style="{ThemeResource MutedTextStyle}" Text="School Average" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CLASS BREAKDOWN TABLE -->
            <Border Style="{ThemeResource TableCardStyle}">
                <StackPanel>
                    <Border Style="{ThemeResource CardHeaderBorderStyle}">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Class Breakdown" />
                    </Border>
                    <Border Style="{ThemeResource TableHeaderRowStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}" Text="CLASS" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}" Text="STUDENTS" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}" Text="AVERAGE" />
                            <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}" Text="AT RISK" />
                            <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}" Text="EXCELLENT" />
                            <TextBlock Grid.Column="5" Style="{ThemeResource TableHeaderStyle}" Text="TREND" />
                        </Grid>
                    </Border>
                    <ListView ItemsSource="{Binding ClassBreakdown}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="16,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding ClassName}" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Style="{ThemeResource NumericCellStyle}"
                                               Text="{Binding StudentCount}" />
                                    <TextBlock Grid.Column="2" FontSize="14" FontWeight="Bold"
                                               Foreground="{ThemeResource PrimaryBlueBrush}"
                                               VerticalAlignment="Center"
                                               Text="{Binding Average, Converter={StaticResource PercentConverter}}" />
                                    <TextBlock Grid.Column="3" Style="{ThemeResource NumericCellStyle}"
                                               Foreground="{ThemeResource DangerRedBrush}"
                                               Text="{Binding AtRisk}" />
                                    <TextBlock Grid.Column="4" Style="{ThemeResource NumericCellStyle}"
                                               Foreground="{ThemeResource SuccessGreenBrush}"
                                               Text="{Binding Excellent}" />
                                    <TextBlock Grid.Column="5" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding Trend}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
