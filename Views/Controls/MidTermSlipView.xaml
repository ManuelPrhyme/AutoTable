<UserControl
    x:Class="AutoTable.Views.Controls.MidTermSlipView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="794" Height="270" Background="White" FontFamily="Segoe UI">

    <!-- Compact mid-term slip: ~270px tall so 3 fit on A4 with margins -->
    <Border BorderBrush="#2E86C1" BorderThickness="2" Margin="10" CornerRadius="2">
        <Grid Margin="14" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- School header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding SchoolName}" FontSize="14" FontWeight="Bold" Foreground="#1A5276" />
                <TextBlock Text="{Binding Term}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Title -->
            <Border Grid.Row="1" Background="#2E86C1" CornerRadius="3" Padding="8,3">
                <TextBlock Text="MID-TERM REPORT SLIP" FontSize="11" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" />
            </Border>

            <!-- Bio row -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="1">
                    <TextBlock Text="STUDENT NAME" FontSize="7" Foreground="#77809A" />
                    <TextBlock Text="{Binding StudentName}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="LIN" FontSize="7" Foreground="#77809A" />
                    <TextBlock Text="{Binding AdmissionNumber}" FontSize="9" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="1">
                    <TextBlock Text="CLASS" FontSize="7" Foreground="#77809A" />
                    <TextBlock Text="{Binding ClassName}" FontSize="9" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="1">
                    <TextBlock Text="STREAM" FontSize="7" Foreground="#77809A" />
                    <TextBlock Text="{Binding Stream}" FontSize="9" />
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="1">
                    <TextBlock Text="GUARDIAN" FontSize="7" Foreground="#77809A" />
                    <TextBlock Text="{Binding GuardianName}" FontSize="9" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- Results table -->
            <Border Grid.Row="3" BorderBrush="#D4E6F1" BorderThickness="1" Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <!-- Header -->
                    <Border Grid.ColumnSpan="5" Background="#D4E6F1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SUBJECT" FontSize="8" FontWeight="Bold" Padding="4,2" />
                            <TextBlock Grid.Column="1" Text="ASSESSMENT" FontSize="8" FontWeight="Bold" Padding="4,2" />
                            <TextBlock Grid.Column="2" Text="MARK %" FontSize="8" FontWeight="Bold" Padding="4,2" />
                            <TextBlock Grid.Column="3" Text="GRADE" FontSize="8" FontWeight="Bold" Padding="4,2" />
                            <TextBlock Grid.Column="4" Text="REMARKS" FontSize="8" FontWeight="Bold" Padding="4,2" />
                        </Grid>
                    </Border>
                    <!-- Data rows -->
                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="5" ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Subject}" FontSize="9" Padding="4,1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding AssessmentName}" FontSize="9" Padding="4,1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Mark}" FontSize="9" Padding="4,1" />
                                    <TextBlock Grid.Column="3" Text="{Binding Grade}" FontSize="9" FontWeight="SemiBold" Padding="4,1" />
                                    <TextBlock Grid.Column="4" Text="{Binding Remarks}" FontSize="8" Padding="4,1" Foreground="#555" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Summary bar -->
            <Grid Grid.Row="4" ColumnSpacing="6" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="#D4E6F1" BorderThickness="1" CornerRadius="2" Padding="6,2">
                    <StackPanel Spacing="1">
                        <TextBlock Text="AVERAGE" FontSize="7" Foreground="#77809A" />
                        <TextBlock Text="{Binding OverallAverage}" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" BorderBrush="#D4E6F1" BorderThickness="1" CornerRadius="2" Padding="6,2">
                    <StackPanel Spacing="1">
                        <TextBlock Text="GRADE" FontSize="7" Foreground="#77809A" />
                        <TextBlock Text="{Binding OverallGrade}" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="#D4E6F1" BorderThickness="1" CornerRadius="2" Padding="6,2">
                    <StackPanel Spacing="1">
                        <TextBlock Text="RANK" FontSize="7" Foreground="#77809A" />
                        <TextBlock Text="{Binding Rank}" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" BorderBrush="#D4E6F1" BorderThickness="1" CornerRadius="2" Padding="6,2">
                    <StackPanel Spacing="1">
                        <TextBlock Text="STATUS" FontSize="7" Foreground="#77809A" />
                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="6">
                    <TextBlock Text="__________________________" FontSize="8" Foreground="#555" />
                    <TextBlock Text="{Binding ClassTeacherLine}" FontSize="8" Foreground="#555" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
