<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AutoTable.Controls.AuthIllustration"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Width="420" Height="360">
        <!-- Spreadsheet sheet -->
        <Border
            Width="260"
            Height="180"
            Margin="0,40,80,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{ThemeResource SurfaceWhiteBrush}"
            BorderBrush="{ThemeResource BorderMediumBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0.95">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="36" Height="10" Background="{ThemeResource BlueBrush}" CornerRadius="2" />
                    <Border Width="36" Height="10" Background="{ThemeResource GreenBrush}" CornerRadius="2" />
                    <Border Width="36" Height="10" Background="{ThemeResource OrangeBrush}" CornerRadius="2" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Margin="2" Background="{ThemeResource SurfaceGray2Brush}" CornerRadius="2" />
                    <Border Grid.Row="0" Grid.Column="1" Margin="2" Background="{ThemeResource BlueLightBrush}" CornerRadius="2" />
                    <Border Grid.Row="0" Grid.Column="2" Margin="2" Background="{ThemeResource GreenLightBrush}" CornerRadius="2" />
                    <Border Grid.Row="0" Grid.Column="3" Margin="2" Background="{ThemeResource RedLightBrush}" CornerRadius="2" />
                    <Border Grid.Row="1" Grid.Column="0" Margin="2" Background="{ThemeResource SurfaceGray2Brush}" CornerRadius="2" />
                    <Border Grid.Row="1" Grid.Column="1" Margin="2" Background="{ThemeResource BlueLightBrush}" CornerRadius="2" />
                    <Border Grid.Row="1" Grid.Column="2" Margin="2" Background="{ThemeResource GreenLightBrush}" CornerRadius="2" />
                    <Border Grid.Row="1" Grid.Column="3" Margin="2" Background="{ThemeResource OrangeLightBrush}" CornerRadius="2" />
                    <Border Grid.Row="2" Grid.Column="0" Margin="2" Background="{ThemeResource SurfaceGray2Brush}" CornerRadius="2" />
                    <Border Grid.Row="2" Grid.Column="1" Margin="2" Background="{ThemeResource BlueLightBrush}" CornerRadius="2" />
                    <Border Grid.Row="2" Grid.Column="2" Margin="2" Background="{ThemeResource GreenLightBrush}" CornerRadius="2" />
                    <Border Grid.Row="2" Grid.Column="3" Margin="2" Background="{ThemeResource OrangeLightBrush}" CornerRadius="2" />
                    <Border Grid.Row="3" Grid.Column="0" Margin="2" Background="{ThemeResource SurfaceGray2Brush}" CornerRadius="2" />
                    <Border Grid.Row="3" Grid.Column="1" Margin="2" Background="{ThemeResource BlueLightBrush}" CornerRadius="2" />
                    <Border Grid.Row="3" Grid.Column="2" Margin="2" Background="{ThemeResource GreenLightBrush}" CornerRadius="2" />
                    <Border Grid.Row="3" Grid.Column="3" Margin="2" Background="{ThemeResource OrangeLightBrush}" CornerRadius="2" />
                </Grid>
            </Grid>
        </Border>

        <!-- Bar chart card -->
        <Border
            Width="180"
            Height="140"
            Margin="0,0,0,20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SurfaceWhiteBrush}"
            BorderBrush="{ThemeResource BorderMediumBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0.95">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Class Performance" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                <StackPanel
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Border Width="18" VerticalAlignment="Bottom" Height="40" Background="{ThemeResource BlueBrush}" CornerRadius="3" />
                    <Border Width="18" VerticalAlignment="Bottom" Height="62" Background="{ThemeResource GreenBrush}" CornerRadius="3" />
                    <Border Width="18" VerticalAlignment="Bottom" Height="48" Background="{ThemeResource PurpleBrush}" CornerRadius="3" />
                    <Border Width="18" VerticalAlignment="Bottom" Height="72" Background="{ThemeResource OrangeBrush}" CornerRadius="3" />
                    <Border Width="18" VerticalAlignment="Bottom" Height="55" Background="{ThemeResource RedBrush}" CornerRadius="3" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Line trend card -->
        <Border
            Width="200"
            Height="110"
            Margin="40,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SurfaceWhiteBrush}"
            BorderBrush="{ThemeResource BorderMediumBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0.92">
            <Grid Margin="12">
                <TextBlock Text="Term Trend" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                <Polyline
                    Margin="0,18,0,0"
                    Stroke="{ThemeResource BlueBrush}"
                    StrokeThickness="3"
                    Points="0,50 30,42 60,38 90,28 120,22 150,18" />
                <Polyline
                    Margin="0,18,0,0"
                    Stroke="{ThemeResource GreenBrush}"
                    StrokeThickness="2"
                    Opacity="0.8"
                    Points="0,58 30,52 60,48 90,40 120,34 150,30" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
