<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.ReportCardsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <Border Style="{ThemeResource FilterBarStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Header="Class" MinWidth="100"
                              ItemsSource="{Binding Classes}"
                              SelectedItem="{Binding SelectedClass, Mode=TwoWay}" />
                    <ComboBox Grid.Column="1" Header="Term" MinWidth="140"
                              ItemsSource="{Binding Terms}"
                              SelectedItem="{Binding SelectedTerm, Mode=TwoWay}" />
                    <ComboBox Grid.Column="2" Header="Stream" MinWidth="120"
                              ItemsSource="{Binding Streams}"
                                                      SelectedItem="{Binding SelectedStream, Mode=TwoWay}" />
                    <TextBox Grid.Column="3" Header="Search by name or initials"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Bottom" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="Generate All" Style="{ThemeResource SecondaryButtonStyle}"
                                Command="{Binding GenerateAllCommand}" />
                        <Button Content="Print All" Style="{ThemeResource PrimaryButtonStyle}"
                                Click="PrintAll_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Total Students" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}" Text="{Binding TotalStudents}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Generated" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource SuccessGreenBrush}"
                                   Text="{Binding GeneratedCount}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Printed" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource PrimaryBlueBrush}"
                                   Text="{Binding PrintedCount}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{ThemeResource TableCardStyle}">
                <StackPanel>
                    <Border Style="{ThemeResource CardHeaderBorderStyle}">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Report Cards" />
                    </Border>
                    <Border Style="{ThemeResource TableHeaderRowStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}" Text="#" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}" Text="STUDENT" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}" Text="LIN" />
                            <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}" Text="CLASS" />
                            <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}" Text="AVERAGE" />
                            <TextBlock Grid.Column="5" Style="{ThemeResource TableHeaderStyle}" Text="STATUS" />
                            <TextBlock Grid.Column="6" Style="{ThemeResource TableHeaderStyle}" Text="ACTIONS" />
                        </Grid>
                    </Border>
                    <ListView ItemsSource="{Binding ReportCards}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="16,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource MutedTextStyle}"
                                               Text="{Binding Rank}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding StudentName}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding AdmissionNumber}" />
                                    <TextBlock Grid.Column="3" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding ClassName}" />
                                    <TextBlock Grid.Column="4" FontSize="14" FontWeight="Bold"
                                               Foreground="{ThemeResource PrimaryBlueBrush}"
                                               VerticalAlignment="Center"
                                               Text="{Binding Average, Converter={StaticResource PercentConverter}}" />
                                    <TextBlock Grid.Column="5" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding Status}" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                                            <Button Content="View" Style="{ThemeResource SecondaryButtonStyle}"
                                                    Padding="8,4" FontSize="12" Click="ViewReport_Click" />
                                            <Button Content="Print" Style="{ThemeResource PrimaryButtonStyle}"
                                                    Padding="8,4" FontSize="12" Click="PrintReport_Click" />
                                        </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

