<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.PromotionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <Grid x:Name="PromotionRoot" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{ThemeResource FilterBarStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Header="Class (Term 3 move-up)" MinWidth="200"
                          ItemsSource="{Binding Classes}"
                          SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                          DisplayMemberPath="Name" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Content="Process All" Command="{Binding ProcessAllCommand}"
                            Style="{ThemeResource PrimaryButtonStyle}" />
                    <Button Content="Refresh" Command="{Binding ReloadCommand}"
                            Style="{ThemeResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Border Style="{ThemeResource KpiCardStyle}" MinWidth="170">
                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Suggested Promoted" />
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource SuccessGreenBrush}"
                               Text="{Binding SuggestedPromoteCount}" />
                </StackPanel>
            </Border>
            <Border Style="{ThemeResource KpiCardStyle}" MinWidth="170">
                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Suggested Repeat" />
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource DangerRedBrush}"
                               Text="{Binding SuggestedRepeatCount}" />
                </StackPanel>
            </Border>
            <Border Style="{ThemeResource KpiCardStyle}" MinWidth="170">
                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Pending Decisions" />
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource PrimaryBlueBrush}"
                               Text="{Binding PendingCount}" />
                </StackPanel>
            </Border>
        </StackPanel>
        <ListView Grid.Row="2" ItemsSource="{Binding Rows}" SelectionMode="None"
                  Background="{ThemeResource SurfaceWhiteBrush}" BorderBrush="{ThemeResource BorderLightBrush}"
                  BorderThickness="1" Padding="8">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,10" BorderBrush="{ThemeResource BorderLightBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextPrimaryBrush}"
                                               Text="{Binding StudentName}" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                                               Text="{Binding ClassName, Mode=OneTime}" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="4" Padding="8,2" Background="{ThemeResource NavySidebarBrush}">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextOnDarkBrush}" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <StackPanel>
                                    <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Average" FontSize="11" />
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding AverageDisplay}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Pass mark" FontSize="11" />
                                    <TextBlock FontSize="14" Text="{Binding PassMark}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Grade" FontSize="11" />
                                    <TextBlock FontSize="14" Text="{Binding Grade}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Suggested" FontSize="11" />
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding SuggestedLabel}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Next class" FontSize="11" />
                                    <TextBlock FontSize="14" Text="{Binding TargetClassName}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Promote" Style="{ThemeResource PrimaryButtonStyle}"
                                        Command="{Binding DataContext.PromoteCommand, ElementName=PromotionRoot}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Repeat" Style="{ThemeResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.RepeatCommand, ElementName=PromotionRoot}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Shift\u2026" Style="{ThemeResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.ShiftCommand, ElementName=PromotionRoot}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Reset" Style="{ThemeResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.ResetCommand, ElementName=PromotionRoot}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="3" Style="{ThemeResource MutedTextStyle}" Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</Page>
