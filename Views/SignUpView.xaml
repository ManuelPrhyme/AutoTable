<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.SignUpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AutoTable.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="520" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource NavyDarkBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:AuthIllustration
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <StackPanel
                Grid.Row="1"
                Margin="48,0,48,48"
                Spacing="12">
                <TextBlock
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Join AutoTable" />
                <TextBlock
                    MaxWidth="420"
                    Foreground="#CBD5E1"
                    Text="Create an account to manage marks entry, performance analytics, and student reports."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="{StaticResource SurfaceWhiteBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel
                    MaxWidth="380"
                    Margin="0,60,0,40"
                    HorizontalAlignment="Center"
                    Spacing="16">
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Create account" />
                    <TextBlock
                        Style="{StaticResource MutedTextStyle}"
                        Text="Choose your role and set up access." />

                    <TextBox
                        x:Name="FullNameBox"
                        Header="Full name"
                        PlaceholderText="Jane Okello" />

                    <TextBox
                        x:Name="EmailBox"
                        Header="Email"
                        PlaceholderText="name@school.edu"
                        InputScope="EmailNameOrAddress" />

                    <PasswordBox
                        x:Name="PasswordBox"
                        Header="Password"
                        PlaceholderText="Create a password" />

                    <ComboBox
                        x:Name="RoleBox"
                        Header="Role"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="1">
                        <ComboBoxItem Content="Administrator" Tag="Administrator" />
                        <ComboBoxItem Content="Data Entrant" Tag="DataEntrant" />
                    </ComboBox>

                    <TextBlock
                        x:Name="ErrorText"
                        Foreground="{StaticResource DangerRedBrush}"
                        TextWrapping="WrapWholeWords"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="CreateButton"
                        HorizontalAlignment="Stretch"
                        Content="Create Account"
                        Style="{StaticResource PrimaryButtonStyle}" />

                    <Button
                        x:Name="CancelButton"
                        HorizontalAlignment="Stretch"
                        Content="Back to Sign In"
                        Style="{StaticResource GhostButtonStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
