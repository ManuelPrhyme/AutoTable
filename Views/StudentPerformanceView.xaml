<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.StudentPerformanceView"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <!-- FILTER BAR -->
            <Border Style="{ThemeResource FilterBarStyle}">
                <StackPanel Spacing="10">
                    <!-- Row 1: Filters -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Academic Year -->
                        <ComboBox Grid.Column="0" Header="Academic Year" MinWidth="130" Style="{ThemeResource ComboBoxStyle}"
                                  ItemsSource="{Binding AcademicYears}"
                                  SelectedItem="{Binding SelectedAcademicYear, Mode=TwoWay}" />

                        <!-- Term -->
                        <ComboBox Grid.Column="1" Header="Term" MinWidth="140" Style="{ThemeResource ComboBoxStyle}"
                                  ItemsSource="{Binding Terms}"
                                  SelectedItem="{Binding SelectedTerm, Mode=TwoWay}" />

                        <!-- Class -->
                        <ComboBox Grid.Column="2" Header="Class" MinWidth="100" Style="{ThemeResource ComboBoxStyle}"
                                  ItemsSource="{Binding Classes}"
                                  SelectedItem="{Binding SelectedClass, Mode=TwoWay}" />

                        <!-- Stream -->
                        <ComboBox Grid.Column="3" Header="Stream" MinWidth="120" Style="{ThemeResource ComboBoxStyle}"
                                  ItemsSource="{Binding Streams}"
                                  SelectedItem="{Binding SelectedStream, Mode=TwoWay}" />

                        <!-- Student -->
                        <ComboBox Grid.Column="4" Header="Student" MinWidth="160" Style="{ThemeResource ComboBoxStyle}"
                                  ItemsSource="{Binding AllStudents}"
                                  SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" />

                        <!-- Subject -->
                        <ComboBox Grid.Column="5" Header="Subject" MinWidth="160" Style="{ThemeResource ComboBoxStyle}"
                                  ItemsSource="{Binding Subjects}"
                                  SelectedItem="{Binding SelectedSubject, Mode=TwoWay}" />

                        <!-- Load Button -->
                        <Button Grid.Column="6" VerticalAlignment="Bottom"
                                Content="Load" Style="{ThemeResource SecondaryButtonStyle}"
                                Command="{Binding LoadCommand}" />
                    </Grid>

                    <!-- Row 2: Search Bar -->
                    <TextBox Style="{ThemeResource SearchBoxStyle}"
                             PlaceholderText="Search by student name..."
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <!-- KPI STRIP -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Total Students" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}" Text="{Binding TotalStudents}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Class Average" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource PrimaryBlueBrush}"
                                   Text="{Binding ClassAverage, Converter={StaticResource PercentConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="At Risk" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource DangerRedBrush}"
                                   Text="{Binding AtRiskCount}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Excellent (≥80%)" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource SuccessGreenBrush}"
                                   Text="{Binding ExcellentCount}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- STUDENT PERFORMANCE TABLE -->
            <Border Style="{ThemeResource TableCardStyle}">
                <StackPanel>
                    <Border Style="{ThemeResource CardHeaderBorderStyle}">
                        <Grid>
                            <TextBlock Style="{ThemeResource SectionTitleStyle}"
                                       Text="Student Performance Summary" VerticalAlignment="Center" />
                            <Button Grid.Column="1" HorizontalAlignment="Right" Content="Export Report"
                                    Style="{ThemeResource PrimaryButtonStyle}"
                                    Command="{Binding ExportCommand}" />
                        </Grid>
                    </Border>

                    <Border Style="{ThemeResource TableHeaderRowStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}" Text="RANK" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}" Text="STUDENT" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}" Text="ADM NO." />
                            <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}" Text="CAT AVG" />
                            <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}" Text="MID TERM" />
                            <TextBlock Grid.Column="5" Style="{ThemeResource TableHeaderStyle}" Text="END TERM" />
                            <TextBlock Grid.Column="6" Style="{ThemeResource TableHeaderStyle}" Text="OVERALL" />
                            <TextBlock Grid.Column="7" Style="{ThemeResource TableHeaderStyle}" Text="GRADE" />
                            <TextBlock Grid.Column="8" Style="{ThemeResource TableHeaderStyle}" Text="STATUS" />
                            <TextBlock Grid.Column="9" Style="{ThemeResource TableHeaderStyle}" Text="" />
                        </Grid>
                    </Border>

                    <ListView ItemsSource="{Binding Students}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="16,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource MutedTextStyle}"
                                               Text="{Binding Rank}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding StudentName}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding AdmissionNumber}" />
                                    <TextBlock Grid.Column="3" Style="{ThemeResource NumericCellStyle}"
                                               Text="{Binding Cat1, Converter={StaticResource DecimalConverter}}" />
                                    <TextBlock Grid.Column="4" Style="{ThemeResource NumericCellStyle}"
                                               Text="{Binding MidTerm, Converter={StaticResource DecimalConverter}}" />
                                    <TextBlock Grid.Column="5" Style="{ThemeResource NumericCellStyle}"
                                               Text="{Binding EndTerm, Converter={StaticResource DecimalConverter}}" />
                                    <TextBlock Grid.Column="6" FontSize="14" FontWeight="Bold"
                                               Foreground="{ThemeResource PrimaryBlueBrush}"
                                               VerticalAlignment="Center"
                                               Text="{Binding Average, Converter={StaticResource PercentConverter}}" />
                                    <Border Grid.Column="7" CornerRadius="6" Padding="6,2"
                                            Background="{ThemeResource InfoBlueLightBrush}"
                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Grade}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{ThemeResource InfoBlueBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="8" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding Status}" />
                                    <Button Grid.Column="9"
                                            Style="{ThemeResource IconButtonStyle}"
                                            ToolTipService.ToolTip="View Individual Performance"
                                            Click="OpenStudentModal_Click"
                                            Tag="{Binding}">
                                        <FontIcon Glyph="&#xE700;" FontSize="14"
                                                  Foreground="{ThemeResource PrimaryBlueBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

