<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.ModerationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <!-- FILTER BAR -->
            <Border Style="{ThemeResource FilterBarStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Header="Class" MinWidth="100"
                              ItemsSource="{Binding Classes}"
                              SelectedItem="{Binding SelectedClass, Mode=TwoWay}" />
                    <ComboBox Grid.Column="1" Header="Subject" MinWidth="160"
                              ItemsSource="{Binding Subjects}"
                              SelectedItem="{Binding SelectedSubject, Mode=TwoWay}" />
                    <Button Grid.Column="3" VerticalAlignment="Bottom"
                            Content="Load" Style="{ThemeResource SecondaryButtonStyle}"
                            Command="{Binding LoadCommand}" />
                </Grid>
            </Border>

            <!-- STATUS STRIP -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Pending Review" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource WarningAmberBrush}"
                                   Text="{Binding PendingCount}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Approved" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource SuccessGreenBrush}"
                                   Text="{Binding ApprovedCount}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Rejected" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource DangerRedBrush}"
                                   Text="{Binding RejectedCount}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- MODERATION TABLE -->
            <Border Style="{ThemeResource TableCardStyle}">
                <StackPanel>
                    <Border Style="{ThemeResource CardHeaderBorderStyle}">
                        <Grid>
                            <TextBlock Style="{ThemeResource SectionTitleStyle}"
                                       Text="Marks Pending Moderation" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Approve All" Style="{ThemeResource PrimaryButtonStyle}"
                                        Command="{Binding ApproveAllCommand}" />
                                <Button Content="Publish Results" Style="{ThemeResource DangerButtonStyle}"
                                        Command="{Binding PublishCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{ThemeResource TableHeaderRowStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}" Text="ASSESSMENT" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}" Text="CLASS" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}" Text="SUBJECT" />
                            <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}" Text="ENTRIES" />
                            <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}" Text="SUBMITTED BY" />
                            <TextBlock Grid.Column="5" Style="{ThemeResource TableHeaderStyle}" Text="STATUS" />
                            <TextBlock Grid.Column="6" Style="{ThemeResource TableHeaderStyle}" Text="ACTIONS" />
                        </Grid>
                    </Border>

                    <ListView ItemsSource="{Binding ModerationItems}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="16,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding AssessmentName}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding ClassName}" />
                                    <TextBlock Grid.Column="2" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding Subject}" />
                                    <TextBlock Grid.Column="3" Style="{ThemeResource NumericCellStyle}"
                                               Text="{Binding EntryCount}" />
                                    <TextBlock Grid.Column="4" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding SubmittedBy}" />
                                    <TextBlock Grid.Column="5" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding Status}" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                                        <Button Content="Approve" Style="{ThemeResource PrimaryButtonStyle}"
                                                Padding="8,4" FontSize="12" />
                                        <Button Content="Reject" Style="{ThemeResource DangerButtonStyle}"
                                                Padding="8,4" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

