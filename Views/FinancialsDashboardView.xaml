<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.FinancialsDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="20">

            <!-- KPI CARDS ROW -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="180">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="10,0,0,10" Background="{ThemeResource SuccessGreenBrush}" />
                        <StackPanel Grid.Column="1" Padding="14,14" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C7;" FontSize="15" Foreground="{ThemeResource SuccessGreenBrush}" />
                                <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Total Collected" />
                            </StackPanel>
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"
                                       Text="{Binding TotalCollected, Converter={StaticResource CurrencyConverter}}" />
                            <TextBlock Style="{ThemeResource MutedTextStyle}" Text="This term" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="180">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="10,0,0,10" Background="{ThemeResource WarningAmberBrush}" />
                        <StackPanel Grid.Column="1" Padding="14,14" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE783;" FontSize="15" Foreground="{ThemeResource WarningAmberBrush}" />
                                <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Outstanding Fees" />
                            </StackPanel>
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"
                                       Text="{Binding OutstandingFees, Converter={StaticResource CurrencyConverter}}" />
                            <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Unpaid balance" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="180">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="10,0,0,10" Background="{ThemeResource PrimaryBlueBrush}" />
                        <StackPanel Grid.Column="1" Padding="14,14" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="{ThemeResource PrimaryBlueBrush}" />
                                <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Budget Used" />
                            </StackPanel>
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"
                                       Text="{Binding BudgetUsedPercent, Converter={StaticResource PercentConverter}}" />
                            <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Of annual budget" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="180">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="10,0,0,10" Background="{ThemeResource AccentPurpleBrush}" />
                        <StackPanel Grid.Column="1" Padding="14,14" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{ThemeResource AccentPurpleBrush}" />
                                <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Students Paid" />
                            </StackPanel>
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"
                                       Text="{Binding StudentsPaidPercent, Converter={StaticResource PercentConverter}}" />
                            <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Full payment" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- CHARTS ROW -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Fee Collection by Class -->
                <Border Grid.Column="0" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Fee Collection by Class" />
                            <TextBlock HorizontalAlignment="Right" Style="{ThemeResource MutedTextStyle}"
                                       Text="Term 2, 2025" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="180" Background="{ThemeResource SurfaceGrayBrush}" CornerRadius="8">
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                        Orientation="Horizontal" Spacing="8" Padding="16,16">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                        <Border Width="28" Height="120" Background="{ThemeResource SuccessGreenBrush}" CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.85" />
                                        <Border Width="28" Height="40"  Background="{ThemeResource DangerRedBrush}"   CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Text="P1" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                        <Border Width="28" Height="100" Background="{ThemeResource SuccessGreenBrush}" CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.85" />
                                        <Border Width="28" Height="55"  Background="{ThemeResource DangerRedBrush}"   CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Text="P2" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                        <Border Width="28" Height="90" Background="{ThemeResource SuccessGreenBrush}" CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.85" />
                                        <Border Width="28" Height="65" Background="{ThemeResource DangerRedBrush}"   CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Text="P3" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                        <Border Width="28" Height="130" Background="{ThemeResource SuccessGreenBrush}" CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.85" />
                                        <Border Width="28" Height="25"  Background="{ThemeResource DangerRedBrush}"   CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Text="P4" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                        <Border Width="28" Height="110" Background="{ThemeResource SuccessGreenBrush}" CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.85" />
                                        <Border Width="28" Height="45"  Background="{ThemeResource DangerRedBrush}"   CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Text="P5" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                        <Border Width="28" Height="80" Background="{ThemeResource SuccessGreenBrush}" CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.85" />
                                        <Border Width="28" Height="70" Background="{ThemeResource DangerRedBrush}"   CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Text="P6" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                        <Border Width="28" Height="140" Background="{ThemeResource SuccessGreenBrush}" CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.85" />
                                        <Border Width="28" Height="15"  Background="{ThemeResource DangerRedBrush}"   CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Text="P7" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" Background="{ThemeResource SuccessGreenBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Collected" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" Background="{ThemeResource DangerRedBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Outstanding" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Budget Breakdown -->
                <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Budget Breakdown" />
                        <Border Height="180" Background="{ThemeResource SurfaceGrayBrush}" CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE9D2;" FontSize="36" Foreground="{ThemeResource PrimaryBlueBrush}" />
                                <TextBlock HorizontalAlignment="Center" Style="{ThemeResource MutedTextStyle}" Text="Budget chart" />
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="10" Height="10" Background="{ThemeResource PrimaryBlueBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{ThemeResource MutedTextStyle}" Text="Salaries" />
                                <TextBlock Grid.Column="2" Style="{ThemeResource MutedTextStyle}" Text="62%" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="10" Height="10" Background="{ThemeResource SuccessGreenBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{ThemeResource MutedTextStyle}" Text="Operations" />
                                <TextBlock Grid.Column="2" Style="{ThemeResource MutedTextStyle}" Text="24%" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="10" Height="10" Background="{ThemeResource WarningAmberBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{ThemeResource MutedTextStyle}" Text="Infrastructure" />
                                <TextBlock Grid.Column="2" Style="{ThemeResource MutedTextStyle}" Text="14%" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RECENT TRANSACTIONS -->
            <Border Style="{ThemeResource TableCardStyle}">
                <StackPanel>
                    <Border Style="{ThemeResource CardHeaderBorderStyle}">
                        <Grid>
                            <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Recent Transactions" VerticalAlignment="Center" />
                            <HyperlinkButton HorizontalAlignment="Right" Content="View all →"
                                             FontSize="13" Foreground="{ThemeResource PrimaryBlueBrush}" />
                        </Grid>
                    </Border>
                    <Border Style="{ThemeResource TableHeaderRowStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}" Text="STUDENT" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}" Text="CLASS" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}" Text="TERM" />
                            <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}" Text="AMOUNT" />
                            <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}" Text="DATE" />
                            <TextBlock Grid.Column="5" Style="{ThemeResource TableHeaderStyle}" Text="STATUS" />
                        </Grid>
                    </Border>
                    <ListView ItemsSource="{Binding RecentTransactions}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="16,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding StudentName}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Style="{ThemeResource TableCellStyle}" Text="{Binding ClassName}" />
                                    <TextBlock Grid.Column="2" Style="{ThemeResource TableCellStyle}" Text="{Binding Term}" />
                                    <TextBlock Grid.Column="3" FontSize="14" FontWeight="Bold"
                                               Foreground="{ThemeResource SuccessGreenBrush}" VerticalAlignment="Center"
                                               Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}" />
                                    <TextBlock Grid.Column="4" Style="{ThemeResource TableCellStyle}" Text="{Binding PaymentDate}" />
                                    <TextBlock Grid.Column="5" Style="{ThemeResource TableCellStyle}" Text="{Binding Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

