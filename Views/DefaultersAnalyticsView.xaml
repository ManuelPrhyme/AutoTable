<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.DefaultersAnalyticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <!-- Header -->
            <Grid>
                <StackPanel>
                    <TextBlock Style="{ThemeResource PageTitleStyle}" Text="Defaulters &amp; Cohort Analytics" />
                    <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Track unpaid fees, collection rates, and per-class cohort performance." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="8">
                    <Button Content="📄 Export CSV" Click="ExportCsv_Click" Style="{ThemeResource SecondaryButtonStyle}" />
                    <Button Content="↻ Refresh" Command="{Binding RefreshCommand}" Style="{ThemeResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <!-- Top 10 Worst Defaulters -->
            <Border Style="{ThemeResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="🔴 Top 10 Worst Defaulters" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TopDefaulters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DefaulterRecord" xmlns:models="using:AutoTable.Models">
                                <Grid Padding="8,6" ColumnSpacing="12" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="6" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource ErrorRedBrush}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind BalanceDisplay}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind StudentName}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{x:Bind ClassName}" Style="{ThemeResource MutedTextStyle}" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ExpectedDisplay}" VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind PaidDisplay}" VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind DaysSinceEnrollment}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{ThemeResource MutedTextStyle}" FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Filters row -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="TERM" Style="{ThemeResource MutedTextStyle}" FontSize="11" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding TermNames}"
                              SelectedItem="{Binding SelectedTermName}"
                              Width="200" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="CLASS" Style="{ThemeResource MutedTextStyle}" FontSize="11" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding ClassNames}"
                              SelectedItem="{Binding SelectedClassName}"
                              Width="180" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="MIN BALANCE" Style="{ThemeResource MutedTextStyle}" FontSize="11" FontWeight="SemiBold" />
                    <TextBox x:Name="MinBalanceBox" PlaceholderText="0" Width="140"
                             TextChanged="MinBalanceBox_TextChanged" />
                </StackPanel>
            </StackPanel>

            <!-- KPI Row 1: Defaulters overview -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Total Defaulters" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}" Text="{Binding TotalDefaulters}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Total Owed" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}" Text="{Binding TotalOwed}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Collection Rate" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}" Text="{Binding SchoolCollectionRateDisplay}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- KPI Row 2: Cohort breakdown -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="120">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Students" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}" Text="{Binding TotalStudentsInScope}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="120">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Paid" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}" Text="{Binding PaidInScope}" Foreground="{ThemeResource SuccessGreenBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="120">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Partial" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}" Text="{Binding PartialInScope}" Foreground="{ThemeResource WarningOrangeBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="120">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Unpaid" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}" Text="{Binding UnpaidInScope}" Foreground="{ThemeResource ErrorRedBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Charts row: Pie chart (left) + Bar chart (right) -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Payment Distribution Pie Chart -->
                <Border Grid.Column="0" Style="{ThemeResource CardBorderStyle}" Padding="16" Width="320">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="📊 Payment Distribution" HorizontalAlignment="Center" />
                        <Grid HorizontalAlignment="Center" Width="200" Height="200">
                            <Canvas x:Name="PieCanvas" Width="200" Height="200" />
                            <!-- Center label -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="PieCenterCount" Text="" FontSize="24" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="students" FontSize="11"
                                           Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <!-- Legend -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="12" Height="12" CornerRadius="2" Background="{ThemeResource SuccessGreenBrush}" />
                                <TextBlock Text="Paid" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="12" Height="12" CornerRadius="2" Background="{ThemeResource WarningOrangeBrush}" />
                                <TextBlock Text="Partial" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="12" Height="12" CornerRadius="2" Background="{ThemeResource ErrorRedBrush}" />
                                <TextBlock Text="Unpaid" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Collection Rate Bar Chart -->
                <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="📊 Collection Rate by Class" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="BarChartPanel" Orientation="Horizontal" Spacing="16"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        MinHeight="200" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Two-column: Defaulters list (left) + Cohort summary (right) -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Defaulters table -->
                <Border Grid.Column="0" Style="{ThemeResource TableCardStyle}">
                    <StackPanel>
                        <Border Style="{ThemeResource CardHeaderBorderStyle}">
                            <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Defaulters List" />
                        </Border>

                        <Border Style="{ThemeResource TableHeaderRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}" Text="#" />
                                <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}" Text="STUDENT" />
                                <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}" Text="CLASS" />
                                <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}" Text="EXPECTED" />
                                <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}" Text="PAID" />
                                <TextBlock Grid.Column="5" Style="{ThemeResource TableHeaderStyle}" Text="BALANCE" />
                                <TextBlock Grid.Column="6" Style="{ThemeResource TableHeaderStyle}" Text="DAYS" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ListView ItemsSource="{Binding Defaulters}" SelectionMode="None" MaxHeight="400">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DefaulterRecord" xmlns:models="using:AutoTable.Models">
                                    <Grid Padding="12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="28" Height="28" Fill="{ThemeResource PrimaryBlueBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind StudentName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind AdmissionNumber}" Style="{ThemeResource MutedTextStyle}" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind ClassName}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind ExpectedDisplay}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind PaidDisplay}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{x:Bind BalanceDisplay}" VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="6" Text="{x:Bind DaysSinceEnrollment}" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" Style="{ThemeResource MutedTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Cohort summary -->
                <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Cohort Summary" />

                        <Border Style="{ThemeResource TableHeaderRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}" Text="CLASS" />
                                <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}" Text="STUDENTS" />
                                <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}" Text="PAID" />
                                <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}" Text="PARTIAL" />
                                <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}" Text="UNPAID" />
                                <TextBlock Grid.Column="5" Style="{ThemeResource TableHeaderStyle}" Text="RATE" />
                            </Grid>
                        </Border>

                        <ListView ItemsSource="{Binding CohortSummaries}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CohortSummary" xmlns:models="using:AutoTable.Models">
                                    <Grid Padding="10,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind TotalStudents}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind PaidCount}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource SuccessGreenBrush}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind PartialCount}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource WarningOrangeBrush}" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind UnpaidCount}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource ErrorRedBrush}" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind CollectionRateDisplay}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status message -->
            <TextBlock Text="{Binding StatusMessage}" Style="{ThemeResource MutedTextStyle}" FontSize="12" Margin="0,4,0,0" />

        </StackPanel>
    </ScrollViewer>
</Page>
