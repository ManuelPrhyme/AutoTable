<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AutoTable.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="20">

            <!-- ── HEADER: Title, Search, Status, User ── -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Style="{ThemeResource PageTitleStyle}" Text="Dashboard" />
                    <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Welcome back, Admin" />
                </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <AutoSuggestBox x:Name="SearchBox"
                            Width="420"
                            PlaceholderText="Search students, teachers, classes..."
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged"
                            SuggestionChosen="SearchBox_SuggestionChosen" />
                    </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="{ThemeResource SurfaceWhiteBrush}" CornerRadius="12" Padding="10,6" BorderBrush="{ThemeResource BorderLightBrush}" BorderThickness="1">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Offline Mode" />
                    </Border>
                    <Border Background="{ThemeResource SurfaceWhiteBrush}" CornerRadius="20" Padding="6" BorderBrush="{ThemeResource BorderLightBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="28" Height="28" Fill="{ThemeResource PrimaryBlueBrush}" />
                            <StackPanel>
                                <TextBlock Text="Admin User" FontWeight="SemiBold" />
                                <TextBlock Text="Administrator" Style="{ThemeResource MutedTextStyle}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ── KPI CARDS ROW ── -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel x:Name="KpiPanel" Orientation="Horizontal" Spacing="12" />
            </StackPanel>

            <!-- ── ROW 2: Assessment Progress + Quick Actions ── -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Assessment Progress Table -->
                <Border Grid.Column="0" Style="{ThemeResource TableCardStyle}">
                    <StackPanel>
                        <!-- Card Header -->
                        <Border Style="{ThemeResource CardHeaderBorderStyle}">
                            <Grid>
                                <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Assessment Progress" VerticalAlignment="Center" />
                                <HyperlinkButton HorizontalAlignment="Right" Content="View all →" FontSize="13" Foreground="{ThemeResource PrimaryBlueBrush}" />
                            </Grid>
                        </Border>

                        <!-- Table Header -->
                        <Border Style="{ThemeResource TableHeaderRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}" Text="ASSESSMENT" />
                                <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}" Text="CLASS" />
                                <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}" Text="PROGRESS" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}" Text="" />
                                <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}" Text="STATUS" />
                            </Grid>
                        </Border>

                        <!-- Rows -->
                        <StackPanel x:Name="AssessmentProgressPanel" />
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Quick Actions" />
                        <ItemsControl x:Name="QuickActionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Style="{ThemeResource SecondaryButtonStyle}"
                                        Content="{Binding}"
                                        Click="QuickAction_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── ROW 3: Trend + AI Insights + Recent Activity ── -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Performance Trend Chart Placeholder -->
                <Border Grid.Column="0" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Performance Trend" />
                            <TextBlock HorizontalAlignment="Right" Style="{ThemeResource MutedTextStyle}" Text="8-week" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="160" Background="{ThemeResource SurfaceGrayBrush}" CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <!-- Mini bar chart illustration -->
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                    <Border Width="14" Height="40" Background="{ThemeResource PrimaryBlueBrush}" CornerRadius="3" VerticalAlignment="Bottom" Opacity="0.6" />
                                    <Border Width="14" Height="62" Background="{ThemeResource PrimaryBlueBrush}" CornerRadius="3" VerticalAlignment="Bottom" Opacity="0.7" />
                                    <Border Width="14" Height="48" Background="{ThemeResource PrimaryBlueBrush}" CornerRadius="3" VerticalAlignment="Bottom" Opacity="0.8" />
                                    <Border Width="14" Height="75" Background="{ThemeResource PrimaryBlueBrush}" CornerRadius="3" VerticalAlignment="Bottom" Opacity="0.9" />
                                    <Border Width="14" Height="55" Background="{ThemeResource PrimaryBlueBrush}" CornerRadius="3" VerticalAlignment="Bottom" />
                                    <Border Width="14" Height="80" Background="{ThemeResource PrimaryBlueBrush}" CornerRadius="3" VerticalAlignment="Bottom" />
                                    <Border Width="14" Height="68" Background="{ThemeResource PrimaryBlueBrush}" CornerRadius="3" VerticalAlignment="Bottom" />
                                    <Border Width="14" Height="90" Background="{ThemeResource PrimaryBlueBrush}" CornerRadius="3" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Center" Style="{ThemeResource MutedTextStyle}" Text="Class average over 8 weeks" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{ThemeResource MutedTextStyle}" Text="This Term" />
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{ThemeResource PrimaryBlueBrush}" Text="67.4%" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Last Term" />
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}" Text="63.1%" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- AI Insights -->
                <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentPurpleBrush}" VerticalAlignment="Center" />
                            <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="AI Insights" />
                        </StackPanel>
                        <ListView x:Name="AiInsightsList" IsItemClickEnabled="False" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource SurfaceGrayBrush}" CornerRadius="8" Padding="10,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource AccentPurpleBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                            <TextBlock Text="{Binding}" TextWrapping="WrapWholeWords" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Recent Activity -->
                <Border Grid.Column="2" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Recent Activity" />
                        <ListView x:Name="RecentActivityList" IsItemClickEnabled="False" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,6">
                                        <Ellipse Width="6" Height="6" Fill="{ThemeResource PrimaryBlueBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" Style="{ThemeResource MutedTextStyle}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>