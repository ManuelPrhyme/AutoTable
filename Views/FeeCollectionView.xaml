<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.FeeCollectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <Border Style="{ThemeResource FilterBarStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Header="Class" MinWidth="100"
                              ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass, Mode=TwoWay}" />
                    <ComboBox Grid.Column="1" Header="Term" MinWidth="140"
                              ItemsSource="{Binding Terms}" SelectedItem="{Binding SelectedTerm, Mode=TwoWay}" />
                    <ComboBox Grid.Column="2" Header="Status" MinWidth="120"
                              ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="Refresh" Style="{ThemeResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" />
                        <Button x:Name="RecordPaymentBtn" Content="Record Payment" Style="{ThemeResource SecondaryButtonStyle}" Click="RecordPayment_Click" />
                        <Button x:Name="PrintSlipsBtn" Content="Print Slips" Style="{ThemeResource PrimaryButtonStyle}" Click="PrintSlips_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Total Expected" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"
                                   Text="{Binding TotalExpected, Converter={StaticResource CurrencyConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Collected" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource SuccessGreenBrush}"
                                   Text="{Binding TotalCollected, Converter={StaticResource CurrencyConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Outstanding" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource DangerRedBrush}"
                                   Text="{Binding TotalOutstanding, Converter={StaticResource CurrencyConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Collection Rate" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource PrimaryBlueBrush}"
                                   Text="{Binding CollectionRate, Converter={StaticResource PercentConverter}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{ThemeResource TableCardStyle}">
                <StackPanel>
                    <Border Style="{ThemeResource CardHeaderBorderStyle}">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Fee Collection Register" />
                    </Border>
                    <Border Style="{ThemeResource TableHeaderRowStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}" HorizontalAlignment="Left" Text="#" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}" HorizontalAlignment="Left" Text="STUDENT" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}" HorizontalAlignment="Left" Text="LIN" />
                            <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}" HorizontalAlignment="Left" Text="CLASS" />
                            <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}" HorizontalAlignment="Left" Text="EXPECTED" />
                            <TextBlock Grid.Column="5" Style="{ThemeResource TableHeaderStyle}" HorizontalAlignment="Left" Text="PAID" />
                            <TextBlock Grid.Column="6" Style="{ThemeResource TableHeaderStyle}" HorizontalAlignment="Left" Text="BALANCE" />
                            <TextBlock Grid.Column="7" Style="{ThemeResource TableHeaderStyle}" HorizontalAlignment="Left" Text="STATUS" />
                            <TextBlock Grid.Column="8" Style="{ThemeResource TableHeaderStyle}" HorizontalAlignment="Left" Text="ACTION" />
                            <TextBlock Grid.Column="9" Style="{ThemeResource TableHeaderStyle}" HorizontalAlignment="Left" Text="SLIP" />
                        </Grid>
                    </Border>
                    <ListView ItemsSource="{Binding FeeRecords}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="16,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource MutedTextStyle}"
                                               Text="{Binding RowNumber}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding StudentName}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding AdmissionNumber}" />
                                    <TextBlock Grid.Column="3" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding ClassName}" />
                                    <TextBlock Grid.Column="4" Style="{ThemeResource NumericCellStyle}"
                                               Text="{Binding ExpectedAmount, Converter={StaticResource CurrencyConverter}}" />
                                    <TextBlock Grid.Column="5" FontSize="14" FontWeight="Bold"
                                               Foreground="{ThemeResource SuccessGreenBrush}" VerticalAlignment="Center"
                                               Text="{Binding PaidAmount, Converter={StaticResource CurrencyConverter}}" />
                                    <TextBlock Grid.Column="6" FontSize="14" FontWeight="Bold"
                                               Foreground="{Binding Balance, Converter={StaticResource BalanceColorConverter}}" VerticalAlignment="Center"
                                               Text="{Binding Balance, Converter={StaticResource BalanceTextConverter}}" />
                                    <TextBlock Grid.Column="7" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding PaymentStatus}" />
                                    <Button Grid.Column="8" Content="Edit"
                                            Style="{ThemeResource SecondaryButtonStyle}"
                                            Padding="8,4" FontSize="12" Click="EditFeePayment_Click" />
                                    <Button Grid.Column="9" Content="Print Slip"
                                            Style="{ThemeResource SecondaryButtonStyle}"
                                            Padding="8,4" FontSize="12" Click="PrintSlip_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{ThemeResource MutedTextStyle}"
                       TextWrapping="Wrap" Margin="4,0" />

        </StackPanel>
    </ScrollViewer>
</Page>

