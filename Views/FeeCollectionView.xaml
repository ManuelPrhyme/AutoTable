<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.FeeCollectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <Border Style="{StaticResource FilterBarStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Header="Class" MinWidth="100"
                              ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass, Mode=TwoWay}" />
                    <ComboBox Grid.Column="1" Header="Term" MinWidth="140"
                              ItemsSource="{Binding Terms}" SelectedItem="{Binding SelectedTerm, Mode=TwoWay}" />
                    <ComboBox Grid.Column="2" Header="Status" MinWidth="120"
                              ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" />
                        <Button Content="Record Payment" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RecordPaymentCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Total Expected" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding TotalExpected, Converter={StaticResource CurrencyConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Collected" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"
                                   Text="{Binding TotalCollected, Converter={StaticResource CurrencyConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Outstanding" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}"
                                   Text="{Binding TotalOutstanding, Converter={StaticResource CurrencyConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Collection Rate" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}"
                                   Text="{Binding CollectionRate, Converter={StaticResource PercentConverter}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource TableCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource CardHeaderBorderStyle}">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Fee Collection Register" />
                    </Border>
                    <Border Style="{StaticResource TableHeaderRowStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderStyle}" Text="#" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderStyle}" Text="STUDENT" />
                            <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderStyle}" Text="ADM NO." />
                            <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderStyle}" Text="CLASS" />
                            <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderStyle}" Text="EXPECTED" />
                            <TextBlock Grid.Column="5" Style="{StaticResource TableHeaderStyle}" Text="PAID" />
                            <TextBlock Grid.Column="6" Style="{StaticResource TableHeaderStyle}" Text="BALANCE" />
                            <TextBlock Grid.Column="7" Style="{StaticResource TableHeaderStyle}" Text="STATUS" />
                        </Grid>
                    </Border>
                    <ListView ItemsSource="{Binding FeeRecords}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="16,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource MutedTextStyle}"
                                               Text="{Binding RowNumber}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource TableCellStyle}"
                                               Text="{Binding StudentName}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource TableCellStyle}"
                                               Text="{Binding AdmissionNumber}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource TableCellStyle}"
                                               Text="{Binding ClassName}" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource NumericCellStyle}"
                                               Text="{Binding ExpectedAmount, Converter={StaticResource CurrencyConverter}}" />
                                    <TextBlock Grid.Column="5" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center"
                                               Text="{Binding PaidAmount, Converter={StaticResource CurrencyConverter}}" />
                                    <TextBlock Grid.Column="6" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource DangerRedBrush}" VerticalAlignment="Center"
                                               Text="{Binding Balance, Converter={StaticResource CurrencyConverter}}" />
                                    <TextBlock Grid.Column="7" Style="{StaticResource TableCellStyle}"
                                               Text="{Binding PaymentStatus}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
