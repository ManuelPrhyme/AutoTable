<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.GradebookView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <!-- FILTER BAR -->
            <Border Style="{ThemeResource FilterBarStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Header="Class" MinWidth="100"
                              ItemsSource="{Binding Classes}"
                              SelectedItem="{Binding SelectedClass, Mode=TwoWay}" />
                    <ComboBox Grid.Column="1" Header="Subject" MinWidth="160"
                              ItemsSource="{Binding Subjects}"
                              SelectedItem="{Binding SelectedSubject, Mode=TwoWay}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="Refresh" Style="{ThemeResource SecondaryButtonStyle}"
                                Command="{Binding RefreshCommand}" />
                        <Button x:Name="ExportGradebookBtn" Content="Export" Style="{ThemeResource PrimaryButtonStyle}"
                                Command="{Binding ExportCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI SUMMARY STRIP -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Class Average" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource PrimaryBlueBrush}"
                                   Text="{Binding ClassAverage, Converter={StaticResource PercentConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="At Risk (&lt;40%)" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource DangerRedBrush}"
                                   Text="{Binding AtRiskCount}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Top Performers (≥80%)" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}"
                                   Foreground="{ThemeResource SuccessGreenBrush}"
                                   Text="{Binding TopPerformers}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- GRADEBOOK TABLE -->
            <Border Style="{ThemeResource TableCardStyle}">
                <StackPanel>
                    <Border Style="{ThemeResource CardHeaderBorderStyle}">
                        <Grid>
                            <TextBlock Style="{ThemeResource SectionTitleStyle}"
                                       Text="Gradebook" VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right" Style="{ThemeResource MutedTextStyle}"
                                       Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{ThemeResource TableHeaderRowStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}" Text="#" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}" Text="STUDENT" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}" Text="ADM NO." />
                            <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}" Text="CAT 1" />
                            <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}" Text="CAT 2" />
                            <TextBlock Grid.Column="5" Style="{ThemeResource TableHeaderStyle}" Text="MID TERM" />
                            <TextBlock Grid.Column="6" Style="{ThemeResource TableHeaderStyle}" Text="END TERM" />
                            <TextBlock Grid.Column="7" Style="{ThemeResource TableHeaderStyle}" Text="AVERAGE" />
                            <TextBlock Grid.Column="8" Style="{ThemeResource TableHeaderStyle}" Text="GRADE" />
                            <TextBlock Grid.Column="9" Style="{ThemeResource TableHeaderStyle}" Text="STATUS" />
                        </Grid>
                    </Border>

                    <ListView ItemsSource="{Binding GradebookRows}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="16,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource MutedTextStyle}"
                                               Text="{Binding Rank}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding StudentName}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding AdmissionNumber}" />
                                    <TextBlock Grid.Column="3" Style="{ThemeResource NumericCellStyle}"
                                               Text="{Binding Cat1}" />
                                    <TextBlock Grid.Column="4" Style="{ThemeResource NumericCellStyle}"
                                               Text="{Binding Cat2}" />
                                    <TextBlock Grid.Column="5" Style="{ThemeResource NumericCellStyle}"
                                               Text="{Binding MidTerm}" />
                                    <TextBlock Grid.Column="6" Style="{ThemeResource NumericCellStyle}"
                                               Text="{Binding EndTerm}" />
                                    <TextBlock Grid.Column="7" FontSize="14" FontWeight="Bold"
                                               Foreground="{ThemeResource PrimaryBlueBrush}"
                                               VerticalAlignment="Center"
                                               Text="{Binding Average, Converter={StaticResource DecimalConverter}}" />
                                    <Border Grid.Column="8" CornerRadius="6" Padding="6,2"
                                            Background="{ThemeResource InfoBlueLightBrush}"
                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Grade}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{ThemeResource InfoBlueBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="9" Style="{ThemeResource TableCellStyle}"
                                               Text="{Binding Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

