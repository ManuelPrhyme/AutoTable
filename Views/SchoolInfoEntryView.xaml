<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.SchoolInfoEntryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="520" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{ThemeResource NavyDarkBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Margin="48">
                <FontIcon Glyph="&#xE7C3;" FontSize="64" Foreground="{ThemeResource TextOnDarkBrush}" />
                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextOnDarkBrush}"
                    Text="Welcome to AutoTable"
                    TextAlignment="Center" />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Margin="48,0,48,48"
                Spacing="12">
                <TextBlock
                    FontSize="16"
                    Foreground="{ThemeResource TextOnDarkMutedBrush}"
                    Text="Let's set up your school. This information will be used to register your school on the blockchain and configure your instance."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="{ThemeResource SurfaceGrayBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{ThemeResource CardBorderStyle}" Margin="24,40,24,40" MaxWidth="520">
                    <StackPanel
                        MaxWidth="380"
                        Margin="0,24,0,24"
                        HorizontalAlignment="Center"
                        Spacing="16">

                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Text="School Information" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Enter your school details to get started."
                            TextWrapping="WrapWholeWords" />

                        <TextBox x:Name="SchoolNameBox" Header="School Name" PlaceholderText="e.g. Springfield High School" />
                        <TextBox x:Name="SchoolAddressBox" Header="School Address" PlaceholderText="e.g. 123 Main St, Springfield" />
                        <TextBox x:Name="SchoolPhoneBox" Header="School Phone" PlaceholderText="e.g. +1 555-0123" />
                        <TextBox x:Name="AdminEmailBox" Header="Admin Email" PlaceholderText="e.g. admin@school.edu" />

                        <InfoBar x:Name="InfoBar" IsOpen="False" Severity="Informational" Title="Status" Message="" />
                        <ProgressBar x:Name="ProgressBar" IsIndeterminate="False" Visibility="Collapsed" />

                        <Button x:Name="ContinueButton" Content="Continue" HorizontalAlignment="Stretch" Click="ContinueButton_Click" />
                        <Button x:Name="RequestTokensAgainButton" Content="Request Tokens Again" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="RequestTokensAgain_Click" />
                        <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Stretch" Style="{ThemeResource GhostButtonStyle}" Click="CancelButton_Click" />

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
