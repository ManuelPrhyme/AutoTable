<?xml version="1.0" encoding="utf-8"?>
<Page NavigationCacheMode="Enabled"
    x:Class="AutoTable.Views.TermManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AutoTable.Models"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Style="{ThemeResource PageTitleStyle}" Text="Term Management" />
            <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Create and manage academic terms and per-class fees." />

            <Border x:Name="CreateTermCard" Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="8" Padding="12">
                    <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Create Term" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="NewTermName" PlaceholderText="Term name e.g. Term 1, 2026" Width="300" />
                        <DatePicker x:Name="TermStart" Header="Start" />
                        <DatePicker x:Name="TermEnd" Header="End" />
                        <Button Content="Create" Click="CreateTerm_Click" Style="{ThemeResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- School-wide KPI summary for the selected term -->
            <TextBlock x:Name="KpiHeader" Style="{ThemeResource MutedTextStyle}" Text="Select a term to view school-wide totals." />
            <StackPanel x:Name="KpiCards" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Total Expected" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"
                                   Text="{Binding SchoolExpected, Converter={StaticResource CurrencyConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Collected" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource SuccessGreenBrush}"
                                   Text="{Binding SchoolCollected, Converter={StaticResource CurrencyConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Outstanding" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource DangerRedBrush}"
                                   Text="{Binding SchoolOutstanding, Converter={StaticResource CurrencyConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Collection Rate" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource PrimaryBlueBrush}"
                                   Text="{Binding SchoolCollectionRate, Converter={StaticResource PercentConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Active Students" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"
                                   Text="{Binding SchoolStudentCount}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Existing Terms card -->
                <Border Grid.Column="0" Style="{ThemeResource TableCardStyle}">
                    <StackPanel>
                        <Border Style="{ThemeResource CardHeaderBorderStyle}">
                            <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Existing Terms" />
                        </Border>
                        <ListView x:Name="TermsList" ItemsSource="{Binding Terms}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SimpleLookup">
                                    <Grid Padding="8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Active indicator: colored in code-behind via UpdateActiveIndicators() -->
                                        <Border x:Name="ActiveIndicator" Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                VerticalAlignment="Center" Margin="0,0,8,0"
                                                Background="{ThemeResource TextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                            <Button x:Name="ActivateBtn" Content="Set Active" Padding="8,2" FontSize="11"
                                                    Click="ActivateTerm_Click" Tag="{x:Bind Id}" />
                                            <Button x:Name="DeactivateBtn" Content="Deactivate" Padding="8,2" FontSize="11"
                                                    Style="{ThemeResource SecondaryButtonStyle}"
                                                    Click="DeactivateTerm_Click" Tag="{x:Bind Id}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Per-Class Term Fees card -->
                <Border Grid.Column="1" Style="{ThemeResource TableCardStyle}">
                    <StackPanel>
                        <Border Style="{ThemeResource CardHeaderBorderStyle}">
                            <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Per-Class Term Fees" />
                        </Border>
                        <TextBlock x:Name="SelectedTermLabel" Style="{ThemeResource MutedTextStyle}" Text="Select a term from the list to set fees." Margin="16,4" />
                        <ListView x:Name="ClassesFeeList" ItemsSource="{Binding Classes}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SimpleLookup">
                                    <Grid Padding="8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Width="140" x:Name="FeeBox" Header="Fee Amount" />
                                        <Button Grid.Column="2" Content="Set" Click="SetFee_Click" VerticalAlignment="Bottom" Padding="8,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{Binding StatusMessage}" Style="{ThemeResource MutedTextStyle}" TextWrapping="Wrap" Margin="16,4" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
