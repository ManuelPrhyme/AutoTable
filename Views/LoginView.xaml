<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AutoTable.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="480" />
        </Grid.ColumnDefinitions>

        <!-- Left: illustration panel (sheets & graphs instead of phone) -->
        <Grid Grid.Column="0" Background="{ThemeResource NavyDarkBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:AuthIllustration
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <StackPanel
                Grid.Row="1"
                Margin="48,0,48,48"
                Spacing="12">
                <TextBlock
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextOnDarkBrush}"
                    Text="AutoTable" />
                <TextBlock
                    MaxWidth="420"
                    Foreground="{ThemeResource TextOnDarkMutedBrush}"
                    Text="Marks &amp; Performance Management for Primary Schools. Enter marks, analyze trends, and generate reports with AI assistance."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>

        <!-- Right: white auth panel -->
        <Grid Grid.Column="1" Background="{ThemeResource SurfaceGrayBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{ThemeResource CardBorderStyle}" Margin="24,48,24,40" MaxWidth="480">
                    <StackPanel
                        MaxWidth="360"
                        Margin="0,24,0,24"
                        HorizontalAlignment="Center"
                        Spacing="16">
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        Text="Welcome back" />
                    <TextBlock
                        Style="{ThemeResource MutedTextStyle}"
                        Text="Sign in to continue to your school dashboard." />

                    <TextBox
                        x:Name="UsernameBox"
                        Header="Username"
                        PlaceholderText="username"
                        InputScope="Text" />

                    <PasswordBox
                        x:Name="PasswordBox"
                        Header="Password"
                        PlaceholderText="Enter your password" />

                    <TextBlock
                        x:Name="ErrorText"
                        Foreground="{ThemeResource DangerRedBrush}"
                        TextWrapping="WrapWholeWords"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="SignInButton"
                        HorizontalAlignment="Stretch"
                        Content="Sign In"
                        Style="{ThemeResource PrimaryButtonStyle}" />

                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Don't have an account?" />
                        <HyperlinkButton x:Name="SignUpLink" Content="Sign up" />
                    </StackPanel>

                    <Border
                        Background="{ThemeResource SurfaceGrayBrush}"
                        CornerRadius="8"
                        Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Text="Demo roles" />
                            <TextBlock Style="{ThemeResource MutedTextStyle}" Text="admin@school.edu → Administrator" />
                            <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Any other email → Data Entrant" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

