<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.SchoolSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="School Settings" Style="{ThemeResource PageTitleStyle}" />

        <!-- Two-column content -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="408" MaxWidth="484" />
                <ColumnDefinition Width="*" MinWidth="408" MaxWidth="484" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: School Information + Logo -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <Border Style="{ThemeResource TableCardStyle}">
                        <StackPanel Spacing="12" Padding="16">

                            <TextBlock Text="SCHOOL INFORMATION" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,4" />

                            <TextBox Header="School Name"
                                     Text="{Binding SchoolName, Mode=TwoWay}"
                                     PlaceholderText="e.g. AutoTable Academy" />

                            <TextBox Header="School Address"
                                     Text="{Binding SchoolAddress, Mode=TwoWay}"
                                     PlaceholderText="e.g. Plot 123, Kampala Road" />

                            <TextBox Header="School Phone"
                                     Text="{Binding SchoolPhone, Mode=TwoWay}"
                                     PlaceholderText="e.g. +256 700 123456" />

                            <TextBox Header="School Motto"
                                     Text="{Binding Motto, Mode=TwoWay}"
                                     PlaceholderText="e.g. Knowledge is Power" />

                        </StackPanel>
                    </Border>

                    <Border Style="{ThemeResource TableCardStyle}">
                        <StackPanel Spacing="12" Padding="16">

                            <TextBlock Text="SCHOOL LOGO" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,4" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="120" Height="120"
                                        BorderBrush="{ThemeResource BorderLightBrush}" BorderThickness="1"
                                        CornerRadius="8" Background="#F8F8F8">
                                    <Image x:Name="LogoPreview" Stretch="Uniform" Margin="8" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Upload your school logo"
                                               FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="Supports PNG, JPG, BMP, GIF"
                                               FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                                    <Button x:Name="PickLogoButton" Content="Choose Logo"
                                            Click="PickLogo_Click" Style="{ThemeResource SecondaryButtonStyle}" />
                                    <Button x:Name="ClearLogoButton" Content="Remove Logo"
                                            Click="ClearLogo_Click" Style="{ThemeResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Head Teacher -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <Border Style="{ThemeResource TableCardStyle}">
                        <StackPanel Spacing="12" Padding="16">

                            <TextBlock Text="HEAD TEACHER" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,4" />

                            <TextBox Header="Head Teacher Name"
                                     Text="{Binding HeadTeacherName, Mode=TwoWay}"
                                     PlaceholderText="e.g. Mrs. Jane Smith" />

                        </StackPanel>
                    </Border>

                    <Border Style="{ThemeResource TableCardStyle}">
                        <StackPanel Spacing="12" Padding="16">

                            <TextBlock Text="PREVIEW" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,4" />

                            <Border BorderBrush="{ThemeResource BorderLightBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16" Background="White">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding SchoolName}" FontSize="16" FontWeight="Bold"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding SchoolAddress}" FontSize="12"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SchoolPhone}" FontSize="12"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Motto}" FontSize="11" FontStyle="Italic"
                                               Foreground="{ThemeResource TextMutedBrush}" />
                                    <Border Height="1" Background="{ThemeResource BorderLightBrush}" />
                                    <TextBlock Text="Head Teacher" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding HeadTeacherName}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- Action Bar -->
        <Border Grid.Row="2" Style="{ThemeResource FilterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{ThemeResource SuccessGreenBrush}" FontSize="13" />
                <Button Grid.Column="1" Content="Save Settings" Style="{ThemeResource PrimaryButtonStyle}"
                        Click="Save_Click" MinWidth="140" />
            </Grid>
        </Border>

    </Grid>
</Page>
