<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AutoTable.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar: fixed 240px -->
            <ColumnDefinition Width="240" />
            <!-- Content area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════
             DARK SIDEBAR
        ═══════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="{StaticResource NavySidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Logo / School Brand -->
            <Border Grid.Row="0" Padding="20,24,20,16" BorderBrush="#1E3A5F" BorderThickness="0,0,0,1">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource PrimaryBlueBrush}">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="AutoTable" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextOnDarkBrush}" />
                            <TextBlock Text="Bright Future Primary" FontSize="11" Foreground="{StaticResource TextOnDarkMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Navigation Items -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel Padding="12,16,12,8" Spacing="2">

                    <!-- MODULE: PERFORMANCE -->
                    <TextBlock
                        Text="PERFORMANCE"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextOnDarkMutedBrush}"
                        Margin="8,0,0,6"
                        CharacterSpacing="80" />

                    <Button x:Name="NavDashboard" Tag="Dashboard" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="{StaticResource TextOnDarkBrush}" />
                            <TextBlock Text="Dashboard" Style="{StaticResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavAssessments" Tag="Assessments" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D5;" FontSize="16" Foreground="{StaticResource TextOnDarkBrush}" />
                            <TextBlock Text="Assessments" Style="{StaticResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavMarksEntry" Tag="MarksEntry" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8D3;" FontSize="16" Foreground="{StaticResource TextOnDarkBrush}" />
                            <TextBlock Text="Marks Entry" Style="{StaticResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavGradebook" Tag="Gradebook" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{StaticResource TextOnDarkBrush}" />
                            <TextBlock Text="Gradebook" Style="{StaticResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavStudentPerformance" Tag="StudentPerformance" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{StaticResource TextOnDarkBrush}" />
                            <TextBlock Text="Student Performance" Style="{StaticResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavAnalytics" Tag="Analytics" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D2;" FontSize="16" Foreground="{StaticResource TextOnDarkBrush}" />
                            <TextBlock Text="Analytics" Style="{StaticResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavModeration" Tag="Moderation" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{StaticResource TextOnDarkBrush}" />
                            <TextBlock Text="Moderation" Style="{StaticResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavReportCards" Tag="ReportCards" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{StaticResource TextOnDarkBrush}" />
                            <TextBlock Text="Report Cards" Style="{StaticResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <!-- SEPARATOR -->
                    <Border Height="1" Background="#1E3A5F" Margin="8,12,8,12" />

                    <!-- MODULE: FINANCIALS -->
                    <TextBlock
                        Text="FINANCIALS"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextOnDarkMutedBrush}"
                        Margin="8,0,0,6"
                        CharacterSpacing="80" />

                    <Button x:Name="NavFinDashboard" Tag="FinDashboard" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE825;" FontSize="16" Foreground="{StaticResource TextOnDarkBrush}" />
                            <TextBlock Text="Fin. Dashboard" Style="{StaticResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavFeeCollection" Tag="FeeCollection" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8C7;" FontSize="16" Foreground="{StaticResource TextOnDarkBrush}" />
                            <TextBlock Text="Fee Collection" Style="{StaticResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavBudget" Tag="Budget" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{StaticResource TextOnDarkBrush}" />
                            <TextBlock Text="Budget" Style="{StaticResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <!-- SEPARATOR -->
                    <Border Height="1" Background="#1E3A5F" Margin="8,12,8,12" />

                    <!-- AI INSIGHTS -->
                    <Button x:Name="NavAiInsights" Tag="AiInsights" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{StaticResource AccentPurpleBrush}" />
                            <TextBlock Text="AI Insights" Style="{StaticResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>

            <!-- User Profile Footer -->
            <Border Grid.Row="2" Padding="16,12" BorderBrush="#1E3A5F" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PersonPicture x:Name="SidebarAvatar" Width="32" Height="32" />
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="SidebarUserName" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextOnDarkBrush}" />
                        <TextBlock x:Name="SidebarUserRole" FontSize="11" Foreground="{StaticResource TextOnDarkMutedBrush}" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButtonStyle}" Margin="auto,0,0,0" ToolTipService.ToolTip="Sign Out" Click="SignOut_Click">
                        <FontIcon Glyph="&#xE8FB;" FontSize="14" Foreground="{StaticResource TextOnDarkMutedBrush}" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════
             MAIN CONTENT AREA
        ═══════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{StaticResource SurfaceGrayBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border
                Grid.Row="0"
                Background="{StaticResource SurfaceWhiteBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
                <Grid Height="60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Page Title -->
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Name="PageSubtitleText" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>

                    <!-- Search -->
                    <AutoSuggestBox
                        Grid.Column="1"
                        Margin="16,0"
                        VerticalAlignment="Center"
                        PlaceholderText="Search students, classes..."
                        QueryIcon="Find" />

                    <!-- Right Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ComboBox x:Name="TermSelector" MinWidth="140" SelectedIndex="0" VerticalAlignment="Center">
                            <ComboBoxItem Content="Term 2, 2025" />
                            <ComboBoxItem Content="Term 1, 2025" />
                        </ComboBox>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Notifications">
                            <FontIcon Glyph="&#xE7ED;" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                        <TextBlock x:Name="HeaderUserName" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Frame -->
            <Frame x:Name="ContentFrame" Grid.Row="1" />

            <!-- Status Footer -->
            <controls:StatusFooterBar Grid.Row="2" />
        </Grid>
    </Grid>
</Page>
