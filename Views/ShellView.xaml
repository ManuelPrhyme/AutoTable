<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AutoTable.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar: fixed 240px -->
            <ColumnDefinition Width="240" />
            <!-- Content area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════
             DARK SIDEBAR
        ═══════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="{ThemeResource NavySidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Logo / School Brand -->
            <Border Grid.Row="0" Padding="20,24,20,16" BorderBrush="{ThemeResource SidebarBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource PrimaryBlueBrush}">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="AutoTable" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Bright Future Primary" FontSize="11" Foreground="{ThemeResource TextOnDarkMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Navigation Items -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel Padding="12,16,12,8" Spacing="2">

                    <!-- MODULE: PERFORMANCE -->
                    <TextBlock
                        Text="PERFORMANCE"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnDarkMutedBrush}"
                        Margin="8,0,0,6"
                        CharacterSpacing="80" />

                    <Button x:Name="NavDashboard" Tag="Dashboard" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Dashboard" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavAssessments" Tag="Assessments" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D5;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Assessments" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavMarksEntry" Tag="MarksEntry" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8D3;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Marks Entry" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavGradebook" Tag="Gradebook" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Gradebook" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavStudentPerformance" Tag="StudentPerformance" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Student Performance" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavAnalytics" Tag="Analytics" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D2;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Analytics" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavModeration" Tag="Moderation" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Moderation" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavReportCards" Tag="ReportCards" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Report Cards" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <!-- SEPARATOR -->
                    <Border Height="1" Background="{ThemeResource SidebarBorderBrush}" Margin="8,12,8,12" />

                    <!-- MODULE: ADMIN -->
                    <TextBlock
                        Text="ADMINISTRATION"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnDarkMutedBrush}"
                        Margin="8,0,0,6"
                        CharacterSpacing="80" />

                    <Button x:Name="NavStudents" Tag="Students" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE716;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Students" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavTeachers" Tag="Teachers" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Teachers" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavTermManagement" Tag="TermManagement" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7BE;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Term Management" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavClasses" Tag="Classes" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Classes Management" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavPromotion" Tag="Promotion" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Promotion / Repeat" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>



                    <Button x:Name="NavAuditLog" Tag="AuditLog" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE81C;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Audit Log" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavSchoolSettings" Tag="SchoolSettings" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="School Settings" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="{ThemeResource SidebarBorderBrush}" Margin="8,12,8,12" />

                    <!-- MODULE: FINANCIALS -->
                    <TextBlock
                        Text="FINANCIALS"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnDarkMutedBrush}"
                        Margin="8,0,0,6"
                        CharacterSpacing="80" />

                    <Button x:Name="NavFinDashboard" Tag="FinDashboard" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE825;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Fin. Dashboard" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavFeeCollection" Tag="FeeCollection" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8C7;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Fee Collection" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavDefaulters" Tag="Defaulters" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Defaulters" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavBudget" Tag="Budget" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource TextOnDarkBrush}" />
                            <TextBlock Text="Budget" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                    <!-- SEPARATOR -->
                    <Border Height="1" Background="{ThemeResource SidebarBorderBrush}" Margin="8,12,8,12" />

                    <!-- AI INSIGHTS -->
                    <Button x:Name="NavAiInsights" Tag="AiInsights" Style="{ThemeResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavItem_Click" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentPurpleBrush}" />
                            <TextBlock Text="AI Insights" Style="{ThemeResource SidebarItemTextStyle}" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>

            <!-- User Profile Footer -->
            <Border Grid.Row="2" Padding="16,12" BorderBrush="{ThemeResource SidebarBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PersonPicture x:Name="SidebarAvatar" Width="32" Height="32" />
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="SidebarUserName" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextOnDarkBrush}" />
                        <TextBlock x:Name="SidebarUserRole" FontSize="11" Foreground="{ThemeResource TextOnDarkMutedBrush}" />
                    </StackPanel>
                    <Button Style="{ThemeResource IconButtonStyle}" Margin="0,0,0,0" HorizontalAlignment="Right" ToolTipService.ToolTip="Sign Out" Click="SignOut_Click">
                        <FontIcon Glyph="&#xE8FB;" FontSize="14" Foreground="{ThemeResource TextOnDarkMutedBrush}" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════
             MAIN CONTENT AREA
        ═══════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{ThemeResource SurfaceGrayBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border
                Grid.Row="0"
                Background="{ThemeResource SurfaceWhiteBrush}"
                BorderBrush="{ThemeResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
                <Grid Height="60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Page Title -->
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="PageTitleText" Style="{ThemeResource PageTitleStyle}" />
                        <TextBlock x:Name="PageSubtitleText" Style="{ThemeResource MutedTextStyle}" />
                    </StackPanel>

                    <!-- Search -->
                    <AutoSuggestBox
                        x:Name="TopSearchBox"
                        Grid.Column="1"
                        Margin="16,0"
                        VerticalAlignment="Center"
                        PlaceholderText="Search students, classes..."
                        QueryIcon="Find"
                        TextChanged="TopSearchBox_TextChanged"
                        SuggestionChosen="TopSearchBox_SuggestionChosen">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="8,4">
                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                    <!-- Right Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="TermSelector" MinWidth="140" Style="{ThemeResource ComboBoxStyle}" SelectedIndex="0" VerticalAlignment="Center">
                            <ComboBoxItem Content="Term 2, 2025" />
                            <ComboBoxItem Content="Term 1, 2025" />
                        </ComboBox>
                    <Button Style="{ThemeResource IconButtonStyle}" ToolTipService.ToolTip="Notifications">
                            <FontIcon Glyph="&#xE7ED;" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Button>
                    <ToggleSwitch x:Name="ThemeToggle" OffContent="Light" OnContent="Dark" Toggled="ThemeToggle_Toggled" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeaderUserName" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Frame -->
            <Frame x:Name="ContentFrame" Grid.Row="1" />

            <!-- Status Footer -->
            <controls:StatusFooterBar Grid.Row="2" />
        </Grid>
    </Grid>
</Page>

