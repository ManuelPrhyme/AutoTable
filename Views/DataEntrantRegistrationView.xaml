<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.DataEntrantRegistrationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AutoTable.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="480" />
        </Grid.ColumnDefinitions>

        <!-- Left: illustration panel -->
        <Grid Grid.Column="0" Background="{ThemeResource NavyDarkBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:AuthIllustration
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <StackPanel
                Grid.Row="1"
                Margin="48,0,48,48"
                Spacing="12">
                <TextBlock
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextOnDarkBrush}"
                    Text="Join AutoTable" />
                <TextBlock
                    MaxWidth="420"
                    Foreground="{ThemeResource TextOnDarkMutedBrush}"
                    Text="Enter the invite code provided by your administrator to create your account."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>

        <!-- Right: registration form -->
        <Grid Grid.Column="1" Background="{ThemeResource SurfaceGrayBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{ThemeResource CardBorderStyle}" Margin="24,48,24,40" MaxWidth="480">
                    <StackPanel
                        MaxWidth="360"
                        Margin="0,24,0,24"
                        HorizontalAlignment="Center"
                        Spacing="16">
                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        Text="Create Account" />
                    <TextBlock
                        Style="{ThemeResource MutedTextStyle}"
                        Text="Use your invite code to sign up." />

                    <TextBox
                        x:Name="InviteCodeBox"
                        Header="Invite Code"
                        PlaceholderText="e.g. AB12-CD34"
                        InputScope="Text" />

                    <TextBox
                        x:Name="FullNameBox"
                        Header="Full name"
                        PlaceholderText="e.g. John Doe" />

                    <TextBox
                        x:Name="UsernameBox"
                        Header="Username"
                        PlaceholderText="e.g. jdoe"
                        InputScope="Text" />

                    <PasswordBox
                        x:Name="PasswordBox"
                        Header="Password"
                        PlaceholderText="Create a password" />

                    <PasswordBox
                        x:Name="ConfirmPasswordBox"
                        Header="Confirm password"
                        PlaceholderText="Re-enter your password" />

                    <TextBlock
                        x:Name="ErrorText"
                        Foreground="{ThemeResource DangerRedBrush}"
                        TextWrapping="WrapWholeWords"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="RegisterButton"
                        Click="RegisterButton_Click"
                        HorizontalAlignment="Stretch"
                        Content="Create Account"
                        Style="{ThemeResource PrimaryButtonStyle}" />

                    <Button
                        x:Name="BackToLoginButton"
                        Click="BackToLoginButton_Click"
                        HorizontalAlignment="Stretch"
                        Content="Back to Sign In"
                        Style="{ThemeResource GhostButtonStyle}" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
