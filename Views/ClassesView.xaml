<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTable.Views.ClassesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AutoTable.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SurfaceGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <!-- Header -->
            <StackPanel>
                <TextBlock Style="{ThemeResource PageTitleStyle}" Text="Class Management" />
                <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Create, view and manage all classes in your school." />
            </StackPanel>

            <!-- KPI row -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Total Classes" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}" Text="{Binding Classes.Count}" />
                    </StackPanel>
                </Border>
                <Border Style="{ThemeResource KpiCardStyle}" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource MutedTextStyle}" Text="Total Subjects" />
                        <TextBlock Style="{ThemeResource KpiValueStyle}" Text="{Binding AllSubjects.Count}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Main grid: left list (expanded), right grading systems (compact) -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Classes list and create subject -->
                <Border Grid.Column="0" Style="{ThemeResource TableCardStyle}">
                    <StackPanel>
                        <Border Style="{ThemeResource CardHeaderBorderStyle}">
                            <Grid>
                                <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="All Classes" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button Content="Export" Style="{ThemeResource SecondaryButtonStyle}" />
                                    <Button x:Name="CreateClassButton" Content="+ Create Class" Style="{ThemeResource PrimaryButtonStyle}" Click="CreateClass_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{ThemeResource TableHeaderRowStyle}">
                            <Grid ColumnSpacing="4" Padding="16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{ThemeResource TableHeaderStyle}" Text="#" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Style="{ThemeResource TableHeaderStyle}" Text="CLASS NAME" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="2" Style="{ThemeResource TableHeaderStyle}" Text="SUBJECTS" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="3" Style="{ThemeResource TableHeaderStyle}" Text="GRADING SYSTEM" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="4" Style="{ThemeResource TableHeaderStyle}" Text="CLASS TEACHER" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="5" Style="{ThemeResource TableHeaderStyle}" Text="STUDENTS" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="6" Style="{ThemeResource TableHeaderStyle}" Text="ACTIONS" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ListView x:Name="ClassesList" ItemsSource="{Binding ClassInfos}" IsItemClickEnabled="True" ItemClick="ClassesList_ItemClick" SelectionMode="Single"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ClassInfo" xmlns:models="using:AutoTable.Models">
                                    <Grid Padding="16,8" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Index}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                               Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                        <ItemsControl ItemsSource="{x:Bind Streams}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{ThemeResource MutedTextStyle}" FontSize="12" HorizontalAlignment="Left" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                    <ItemsControl Grid.Column="2" ItemsSource="{x:Bind Subjects}" VerticalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{ThemeResource MutedTextStyle}" FontSize="12" HorizontalAlignment="Left" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Column="3" Text="{x:Bind GradingSystemName}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                               TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind ClassTeacherName}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                               TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind StudentCount}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Button Content="Edit" Tag="{x:Bind}" Click="EditClass_Click"
                                                Style="{ThemeResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" />
                                        <Button Content="Delete" Tag="{x:Bind}" Click="DeleteClass_Click"
                                                Style="{ThemeResource DangerGhostButtonStyle}" Padding="8,3" FontSize="11" />
                                    </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Right: Grading systems (compact) -->
                <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}" MinWidth="280" MaxWidth="340">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource SectionTitleStyle}" Text="Grading Systems" />
                        <Button x:Name="CreateGradingSystemButton" Content="+ New Grading System"
                                Style="{ThemeResource SecondaryButtonStyle}" Click="CreateGradingSystem_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />

                        <ListView x:Name="GradingSystemsList" ItemsSource="{Binding GradingSystems}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:GradingSystemInfo" xmlns:models="using:AutoTable.Models">
                                    <StackPanel Padding="8,6" Spacing="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border CornerRadius="6" Padding="6,2" Background="{ThemeResource InfoBlueLightBrush}"
                                                        Visibility="{x:Bind DefaultVisibility}" VerticalAlignment="Center">
                                                    <TextBlock Text="DEFAULT" FontSize="11" FontWeight="Bold"
                                                               Foreground="{ThemeResource InfoBlueBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Delete" Click="DeleteGradingSystem_Click" Tag="{x:Bind Id}"
                                            Style="{ThemeResource DangerGhostButtonStyle}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind BandsSummary}" Style="{ThemeResource MutedTextStyle}"
                                                   FontSize="12" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

